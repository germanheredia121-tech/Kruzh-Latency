<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="KruzhLatency.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:KruzhLatency.Controls"
    mc:Ignorable="d"
    Title="KRUZH LATENCY">

    <!-- Solid Opaque Root Grid (#0E0F11) - Honest Program Style -->
    <!-- Fondo sólido igual al del contenido: la barra de título queda unificada (antes el degradé #121212 la diferenciaba). -->
    <Grid x:Name="RootGrid" Background="#0F0F0F">
        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ==================== TRANSPARENT CONTINUOUS TITLE BAR ==================== -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent" Padding="18,0">
            <TextBlock
                x:Name="TitleBarPageNameText"
                Text="Inicio"
                FontFamily="Segoe UI Variable Text"
                FontSize="12"
                FontWeight="Normal"
                Foreground="{StaticResource KruzhTextSecondaryBrush}"
                VerticalAlignment="Center"
                Visibility="Collapsed" />
        </Grid>

        <!-- ==================== NATIVE EXPANDABLE NAVIGATIONVIEW ==================== -->
        <NavigationView
            x:Name="MainNavView"
            Grid.Row="1"
            PaneDisplayMode="Left"
            IsPaneToggleButtonVisible="True"
            OpenPaneLength="240"
            CompactPaneLength="48"
            IsPaneOpen="False"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            Background="Transparent"
            PaneOpening="MainNavView_PaneOpening"
            PaneClosing="MainNavView_PaneClosing"
            SelectionChanged="MainNavView_SelectionChanged">

            <NavigationView.PaneCustomContent>
                <Grid Height="42" Margin="0,2,0,6" HorizontalAlignment="Stretch" ToolTipService.ToolTip="KRUZH LATENCY · KRUZH — author">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Fixed 48px container (= CompactPaneLength): Geometric minimalist "K" (20px) stays at the exact same X position collapsed or expanded -->
                    <Grid Grid.Column="0" Width="48" Height="42" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Canvas Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Line X1="4" Y1="2" X2="4" Y2="18" Stroke="#F0F2F4" StrokeThickness="2.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <Line X1="15" Y1="2" X2="4.8" Y2="10.5" Stroke="#F0F2F4" StrokeThickness="2.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <Line X1="7.2" Y1="8.5" X2="15.5" Y2="18" Stroke="#F0F2F4" StrokeThickness="2.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Canvas>
                    </Grid>

                    <!-- Brand text to the right: appears when expanded without moving the K logo a single pixel -->
                    <TextBlock x:Name="PaneBrandHeaderPanel"
                               Grid.Column="1"
                               Text="KRUZH LATENCY"
                               FontSize="12"
                               FontWeight="SemiBold"
                               CharacterSpacing="95"
                               Foreground="{StaticResource KruzhTextPrimaryBrush}"
                               VerticalAlignment="Center"
                               Margin="4,0,0,0"
                               Visibility="Collapsed" />
                </Grid>
            </NavigationView.PaneCustomContent>

            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="NavDashboardItem" Tag="Dashboard" Content="Inicio" IsSelected="True" ToolTipService.ToolTip="Inicio">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavTweaksItem" Tag="Tweaks" Content="Optimizaciones" ToolTipService.ToolTip="Optimizaciones">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavIrqMsiItem" Tag="IrqMsi" Content="GPU" ToolTipService.ToolTip="GPU, MSI Mode v3 e Interrupciones">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE7F4;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavPowerDriversItem" Tag="PowerDrivers" Content="Instaladores" ToolTipService.ToolTip="Instaladores de Drivers y Energía">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE896;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavGamesNvidiaItem" Tag="GamesNvidia" Content="Juegos" ToolTipService.ToolTip="Juegos y Prioridad IFEO">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE7FC;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavBiosNvramItem" Tag="BiosNvram" Content="BIOS" ToolTipService.ToolTip="BIOS y NVRAM (SCEWIN)">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE964;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavMonitorAuditItem" Tag="MonitorAudit" Content="Monitor" ToolTipService.ToolTip="Monitor en Vivo y Auditoría">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE9D2;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.PaneFooter>
                <Grid Height="36" Margin="0,4,0,4" HorizontalAlignment="Stretch" ToolTipService.ToolTip="Estado de licencia">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Width="48" Height="36" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Border x:Name="HeaderLicenseDot" Width="8" Height="8" CornerRadius="4" Background="{StaticResource KruzhPositiveBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock x:Name="HeaderLicenseText" Grid.Column="1" Text="-" FontSize="11.5" Foreground="{StaticResource KruzhTextSecondaryBrush}" VerticalAlignment="Center" Margin="4,0,0,0" Visibility="Collapsed" />
                </Grid>
            </NavigationView.PaneFooter>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="NavConfigItem" Tag="Config" Content="Configuración" ToolTipService.ToolTip="Configuración, Parámetros y Licencia">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE90F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <!-- ALL PAGE CONTENT INSIDE NavigationView.Content -->
            <Grid Background="Transparent">

                    <!-- ======================================================================= -->
                    <!-- VIEW 1: INICIO (NEAR-BLACK, SUBTLE GRADIENT CARDS, HONEST PROGRAM LOOK) -->
                    <!-- ======================================================================= -->
                    <ScrollViewer
                        x:Name="ViewDashboard"
                        Visibility="Visible"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">

                        <StackPanel Padding="48,18,48,36" Spacing="34" MaxWidth="1280" HorizontalAlignment="Stretch">

                            <!-- Clean Page Title (No Top Telemetry Bar) -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Inicio" Style="{StaticResource KruzhPageTitleStyle}" />
                                <TextBlock x:Name="BottomStatusBarText" Text="-" Style="{StaticResource KruzhPageSubtitleStyle}" />
                            </StackPanel>

                            <!-- ROW 1: MONITORES EN VIVO (100% REAL SENSORS, ZERO MOCK DATA, COMPACT) -->
                            <StackPanel Spacing="12">
                                <TextBlock Text="MONITORES EN VIVO" Style="{StaticResource KruzhMicroLabelStyle}" />

                                <Grid ColumnSpacing="16" RowSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Live Monitor 1: CPU % -->
                                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource KruzhCardStyle}" Padding="18,14" Translation="0,0,10">
                                        <Border.Shadow>
                                            <ThemeShadow />
                                        </Border.Shadow>
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="USO DE CPU" Style="{StaticResource KruzhMicroLabelStyle}" VerticalAlignment="Center" />
                                            <TextBlock x:Name="DashboardCpuUsageCardText" Text="-" Style="{StaticResource KruzhMetricLightStyle}" />
                                            <Canvas Height="14" Margin="0,2,0,2">
                                                <Polyline x:Name="HomeCpuSparkline" Stroke="{StaticResource KruzhSparklineBrush}" StrokeThickness="1.5" />
                                            </Canvas>
                                            <TextBlock x:Name="DashboardCpuSubtitleText" Text="-" FontSize="11.5" Foreground="{StaticResource KruzhTextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Live Monitor 2: GPU % -->
                                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource KruzhCardStyle}" Padding="18,14" Translation="0,0,10">
                                        <Border.Shadow>
                                            <ThemeShadow />
                                        </Border.Shadow>
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="USO DE GPU 3D" Style="{StaticResource KruzhMicroLabelStyle}" VerticalAlignment="Center" />
                                            <TextBlock x:Name="DashboardGpuUsageCardText" Text="-" Style="{StaticResource KruzhMetricLightStyle}" />
                                            <Canvas Height="14" Margin="0,2,0,2">
                                                <Polyline x:Name="HomeGpuSparkline" Stroke="{StaticResource KruzhSparklineBrush}" StrokeThickness="1.5" />
                                            </Canvas>
                                            <TextBlock x:Name="DashboardGpuSubtitleText" Text="-" FontSize="11.5" Foreground="{StaticResource KruzhTextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Live Monitor 3: RAM -->
                                    <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource KruzhCardStyle}" Padding="18,14" Translation="0,0,10">
                                        <Border.Shadow>
                                            <ThemeShadow />
                                        </Border.Shadow>
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="MEMORIA RAM" Style="{StaticResource KruzhMicroLabelStyle}" VerticalAlignment="Center" />
                                            <TextBlock x:Name="DashboardRamUsageCardText" Text="-" Style="{StaticResource KruzhMetricLightStyle}" />
                                            <Canvas Height="14" Margin="0,2,0,2">
                                                <Polyline x:Name="HomeRamSparkline" Stroke="{StaticResource KruzhSparklineBrush}" StrokeThickness="1.5" />
                                            </Canvas>
                                            <TextBlock x:Name="DashboardRamSubtitleText" Text="-" FontSize="11.5" Foreground="{StaticResource KruzhTextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Live Monitor 4: Timer Resolution -->
                                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource KruzhCardStyle}" Padding="18,14" Translation="0,0,10">
                                        <Border.Shadow>
                                            <ThemeShadow />
                                        </Border.Shadow>
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="RESOLUCIÓN DE TIMER" Style="{StaticResource KruzhMicroLabelStyle}" VerticalAlignment="Center" />
                                            <TextBlock x:Name="DashboardTimerCardText" Text="-" Style="{StaticResource KruzhMetricLightStyle}" />
                                            <Canvas Height="14" Margin="0,2,0,2">
                                                <Polyline x:Name="HomeTimerSparkline" Stroke="{StaticResource KruzhSparklineBrush}" StrokeThickness="1.5" />
                                            </Canvas>
                                            <TextBlock Text="Reloj de kernel NtQueryTimerResolution" FontSize="11.5" Foreground="{StaticResource KruzhTextSecondaryBrush}" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Live Monitor 5: Kernel / DPC Load -->
                                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource KruzhCardStyle}" Padding="18,14" Translation="0,0,10">
                                        <Border.Shadow>
                                            <ThemeShadow />
                                        </Border.Shadow>
                                        <StackPanel Spacing="4">
                                            <Grid>
                                                <TextBlock Text="LATENCIA DPC / ISR" Style="{StaticResource KruzhMicroLabelStyle}" VerticalAlignment="Center" />
                                                <Border x:Name="DpcStatusPillBorder" HorizontalAlignment="Right" Style="{StaticResource KruzhPositivePillStyle}">
                                                    <TextBlock x:Name="DpcStatusPillText" Text="-" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource KruzhPositiveBrush}" />
                                                </Border>
                                            </Grid>
                                            <TextBlock x:Name="DashboardDpcCardText" Text="-" Style="{StaticResource KruzhMetricLightStyle}" />
                                            <Canvas Height="14" Margin="0,2,0,2">
                                                <Polyline x:Name="HomeDpcSparkline" Stroke="{StaticResource KruzhSparklineBrush}" StrokeThickness="1.5" />
                                            </Canvas>
                                            <TextBlock Text="Tiempo de DPC e interrupciones en vivo" FontSize="11.5" Foreground="{StaticResource KruzhTextSecondaryBrush}" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Live Monitor 6: Optimization Index -->
                                    <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource KruzhCardStyle}" Padding="18,14" Translation="0,0,10">
                                        <Border.Shadow>
                                            <ThemeShadow />
                                        </Border.Shadow>
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="ÍNDICE DE OPTIMIZACIÓN" Style="{StaticResource KruzhMicroLabelStyle}" VerticalAlignment="Center" />
                                            <TextBlock x:Name="DashboardScoreValueText" Text="-" Style="{StaticResource KruzhMetricLightStyle}" />
                                            <Canvas Height="14" Margin="0,2,0,2">
                                                <Polyline x:Name="HomeScoreSparkline" Stroke="{StaticResource KruzhSparklineBrush}" StrokeThickness="1.5" />
                                            </Canvas>
                                            <TextBlock x:Name="DashboardAnticheatText" Text="-" FontSize="11.5" Foreground="{StaticResource KruzhTextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>

                            <!-- ROW 2: SISTEMA (BARRA ÚNICA SEGMENTADA FULL-WIDTH) -->
                            <StackPanel Spacing="12">
                                <TextBlock Text="SISTEMA" Style="{StaticResource KruzhMicroLabelStyle}" />

                                <Border Background="{StaticResource KruzhCardSurfaceBrush}"
                                        BorderBrush="{StaticResource KruzhHairlineBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Translation="0,0,10">
                                    <Border.Shadow>
                                        <ThemeShadow />
                                    </Border.Shadow>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="1" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="1" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="1" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Segment 1: Procesador -->
                                        <StackPanel Grid.Column="0" Padding="18,14" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock Text="PROCESADOR" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource KruzhTextTertiaryBrush}" CharacterSpacing="50" />
                                            <TextBlock x:Name="HwCpuNameText" Text="-" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource KruzhTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock x:Name="HwTopologyText" Text="-" FontSize="11.5" Foreground="{StaticResource KruzhTextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <!-- Divisor 1 -->
                                        <Rectangle Grid.Column="1" Fill="{StaticResource KruzhDividerHairlineBrush}" Width="1" VerticalAlignment="Stretch" Margin="0,10" />

                                        <!-- Segment 2: Gráficos -->
                                        <StackPanel Grid.Column="2" Padding="18,14" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock Text="GRÁFICOS" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource KruzhTextTertiaryBrush}" CharacterSpacing="50" />
                                            <TextBlock x:Name="HwGpuNameText" Text="-" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource KruzhTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock x:Name="HwGpuGenText" Text="-" FontSize="11.5" Foreground="{StaticResource KruzhTextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <!-- Divisor 2 -->
                                        <Rectangle Grid.Column="3" Fill="{StaticResource KruzhDividerHairlineBrush}" Width="1" VerticalAlignment="Stretch" Margin="0,10" />

                                        <!-- Segment 3: Placa Base -->
                                        <StackPanel Grid.Column="4" Padding="18,14" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock Text="PLACA BASE" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource KruzhTextTertiaryBrush}" CharacterSpacing="50" />
                                            <TextBlock x:Name="HwMotherboardText" Text="-" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource KruzhTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock x:Name="HwBiosVersionText" Text="-" FontSize="11.5" Foreground="{StaticResource KruzhTextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <!-- Divisor 3 -->
                                        <Rectangle Grid.Column="5" Fill="{StaticResource KruzhDividerHairlineBrush}" Width="1" VerticalAlignment="Stretch" Margin="0,10" />

                                        <!-- Segment 4: Memoria y Display / Sistema -->
                                        <StackPanel Grid.Column="6" Padding="18,14" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock Text="SISTEMA Y MEMORIA" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource KruzhTextTertiaryBrush}" CharacterSpacing="50" />
                                            <TextBlock x:Name="HwRamMonitorText" Text="-" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource KruzhTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock x:Name="HwChassisText" Text="-" FontSize="11.5" Foreground="{StaticResource KruzhTextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- ROW 3: 3 CARDS DE RECURSOS CON IMAGEN DE FONDO (FULL-BLEED + GRADIENT OVERLAY) -->
                            <StackPanel Spacing="12">
                                <TextBlock Text="RECURSOS" Style="{StaticResource KruzhMicroLabelStyle}" />

                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Resource 1: GPU / Driver Settings -->
                                    <Border x:Name="HomeResourceCard1"
                                            Grid.Column="0"
                                            Height="150"
                                            CornerRadius="12"
                                            BorderBrush="{StaticResource KruzhHairlineBorderBrush}"
                                            BorderThickness="1"
                                            Translation="0,0,12"
                                            RenderTransformOrigin="0.5,0.5"
                                            Tapped="HomeResourceCardGpu_Tapped"
                                            PointerEntered="ResourceCard_PointerEntered"
                                            PointerExited="ResourceCard_PointerExited"
                                            Background="{StaticResource KruzhCardSurfaceBrush}">
                                        <Border.Shadow>
                                            <ThemeShadow />
                                        </Border.Shadow>
                                        <Border.RenderTransform>
                                            <ScaleTransform x:Name="ResourceCardScale1" ScaleX="1.0" ScaleY="1.0" />
                                        </Border.RenderTransform>
                                        <Border CornerRadius="11">
                                            <Border.Background>
                                                <ImageBrush ImageSource="ms-appx:///Assets/Images/driver.jpg" Stretch="UniformToFill" />
                                            </Border.Background>
                                            <Grid CornerRadius="11">
                                                <!-- Dark gradient overlay: transparent at 35% to solid #0E0F11 at bottom -->
                                                <Border CornerRadius="11">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                            <GradientStop Color="#000E0F11" Offset="0.30" />
                                                            <GradientStop Color="#CC0E0F11" Offset="0.75" />
                                                            <GradientStop Color="#FF0E0F11" Offset="1.00" />
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                                <!-- Subtle hover highlight overlay -->
                                                <Border x:Name="ResourceHoverHighlight1" CornerRadius="11" Background="#FFFFFF" Opacity="0.0" />

                                                <FontIcon Glyph="&#xE76C;" FontSize="11" FontFamily="{ThemeResource SymbolThemeFontFamily}" Foreground="{StaticResource KruzhTextTertiaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16" />

                                                <StackPanel VerticalAlignment="Bottom" Margin="18,16" Spacing="4">
                                                    <TextBlock Text="Ajustes de driver / GPU" FontSize="14.5" FontWeight="SemiBold" Foreground="{StaticResource KruzhTextPrimaryBrush}" />
                                                    <TextBlock Text="Overclocking, MSI Mode v3 y perfiles gráficos" FontSize="11.5" Foreground="{StaticResource KruzhTextSecondaryBrush}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Border>

                                    <!-- Resource 2: Kruzh AI / Optimizaciones -->
                                    <Border x:Name="HomeResourceCard2"
                                            Grid.Column="1"
                                            Height="150"
                                            CornerRadius="12"
                                            BorderBrush="{StaticResource KruzhHairlineBorderBrush}"
                                            BorderThickness="1"
                                            Translation="0,0,12"
                                            RenderTransformOrigin="0.5,0.5"
                                            Tapped="HomeResourceCardAi_Tapped"
                                            PointerEntered="ResourceCard_PointerEntered"
                                            PointerExited="ResourceCard_PointerExited"
                                            Background="{StaticResource KruzhCardSurfaceBrush}">
                                        <Border.Shadow>
                                            <ThemeShadow />
                                        </Border.Shadow>
                                        <Border.RenderTransform>
                                            <ScaleTransform x:Name="ResourceCardScale2" ScaleX="1.0" ScaleY="1.0" />
                                        </Border.RenderTransform>
                                        <Border CornerRadius="11">
                                            <Border.Background>
                                                <ImageBrush ImageSource="ms-appx:///Assets/Images/ai.jpg" Stretch="UniformToFill" />
                                            </Border.Background>
                                            <Grid CornerRadius="11">
                                                <Border CornerRadius="11">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                            <GradientStop Color="#000E0F11" Offset="0.30" />
                                                            <GradientStop Color="#CC0E0F11" Offset="0.75" />
                                                            <GradientStop Color="#FF0E0F11" Offset="1.00" />
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                                <Border x:Name="ResourceHoverHighlight2" CornerRadius="11" Background="#FFFFFF" Opacity="0.0" />

                                                <FontIcon Glyph="&#xE76C;" FontSize="11" FontFamily="{ThemeResource SymbolThemeFontFamily}" Foreground="{StaticResource KruzhTextTertiaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16" />

                                                <StackPanel VerticalAlignment="Bottom" Margin="18,16" Spacing="4">
                                                    <TextBlock Text="Kruzh AI" FontSize="14.5" FontWeight="SemiBold" Foreground="{StaticResource KruzhTextPrimaryBrush}" />
                                                    <TextBlock Text="Motor de optimizaciones y baja latencia del sistema" FontSize="11.5" Foreground="{StaticResource KruzhTextSecondaryBrush}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Border>

                                    <!-- Resource 3: Perfil por juego / Configuración -->
                                    <Border x:Name="HomeResourceCard3"
                                            Grid.Column="2"
                                            Height="150"
                                            CornerRadius="12"
                                            BorderBrush="{StaticResource KruzhHairlineBorderBrush}"
                                            BorderThickness="1"
                                            Translation="0,0,12"
                                            RenderTransformOrigin="0.5,0.5"
                                            Tapped="HomeResourceCardGame_Tapped"
                                            PointerEntered="ResourceCard_PointerEntered"
                                            PointerExited="ResourceCard_PointerExited"
                                            Background="{StaticResource KruzhCardSurfaceBrush}">
                                        <Border.Shadow>
                                            <ThemeShadow />
                                        </Border.Shadow>
                                        <Border.RenderTransform>
                                            <ScaleTransform x:Name="ResourceCardScale3" ScaleX="1.0" ScaleY="1.0" />
                                        </Border.RenderTransform>
                                        <Border CornerRadius="11">
                                            <Border.Background>
                                                <ImageBrush ImageSource="ms-appx:///Assets/Images/game.jpg" Stretch="UniformToFill" />
                                            </Border.Background>
                                            <Grid CornerRadius="11">
                                                <Border CornerRadius="11">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                            <GradientStop Color="#000E0F11" Offset="0.30" />
                                                            <GradientStop Color="#CC0E0F11" Offset="0.75" />
                                                            <GradientStop Color="#FF0E0F11" Offset="1.00" />
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                                <Border x:Name="ResourceHoverHighlight3" CornerRadius="11" Background="#FFFFFF" Opacity="0.0" />

                                                <FontIcon Glyph="&#xE76C;" FontSize="11" FontFamily="{ThemeResource SymbolThemeFontFamily}" Foreground="{StaticResource KruzhTextTertiaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16" />

                                                <StackPanel VerticalAlignment="Bottom" Margin="18,16" Spacing="4">
                                                    <TextBlock Text="Perfil por juego" FontSize="14.5" FontWeight="SemiBold" Foreground="{StaticResource KruzhTextPrimaryBrush}" />
                                                    <TextBlock Text="Ajustes por título, sensores en vivo y configuración" FontSize="11.5" Foreground="{StaticResource KruzhTextSecondaryBrush}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Border>
                                </Grid>
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- ======================================================================= -->
                    <!-- VIEW 2: OPTIMIZACIONES — lista minimalista (título + 1 línea + ⓘ + toggle) -->
                    <!-- Solo se listan los tweaks APLICABLES a esta PC (filtro fijo "APPLICABLE"). -->
                    <!-- ======================================================================= -->
                    <Grid x:Name="ViewTweaks" Visibility="Collapsed">
                        <ScrollViewer
                            x:Name="TweaksScrollViewer"
                            ViewChanged="TweaksScrollViewer_ViewChanged"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled"
                            HorizontalScrollMode="Disabled">

                            <StackPanel Padding="48,34,48,120" Spacing="0" MaxWidth="860" HorizontalAlignment="Stretch">

                                <!-- Encabezado -->
                                <Grid Margin="0,0,0,26">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Optimizaciones" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource KruzhTextPrimaryBrush}" />
                                        <TextBlock x:Name="TweaksSummaryCounterText" Text="-" FontSize="13" Foreground="{StaticResource KruzhTextTertiaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="1" VerticalAlignment="Top" Background="Transparent" BorderThickness="0" Padding="8"
                                            Foreground="{StaticResource KruzhTextSecondaryBrush}" ToolTipService.ToolTip="Más opciones">
                                        <FontIcon Glyph="&#xE712;" FontSize="14" />
                                        <Button.Flyout>
                                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                <MenuFlyoutItem x:Name="ImportProfileJsonBtn" Text="Importar perfil…" Click="ImportProfileJsonBtn_Click" />
                                                <MenuFlyoutItem x:Name="ExportProfileJsonBtn" Text="Exportar perfil…" Click="ExportProfileJsonBtn_Click" />
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>

                                <!-- Perfiles (chips de texto) -->
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,24">
                                    <TextBlock Text="Perfil" FontSize="12.5" Foreground="{StaticResource KruzhTextTertiaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <Button Tag="Minimal" Click="SelectPresetProfile_Click" Style="{StaticResource KruzhGhostButtonStyle}" Content="Normal" />
                                    <Button Tag="Competitivo" Click="SelectPresetProfile_Click" Style="{StaticResource KruzhGhostButtonStyle}" Content="Competitivo" />
                                    <Button Tag="Profesional" Click="SelectPresetProfile_Click" Style="{StaticResource KruzhGhostButtonStyle}" Content="Profesional"
                                            ToolTipService.ToolTip="Máximo rendimiento compatible con FACEIT AC y Vanguard" />
                                    <Button Tag="Entusiasta" Click="SelectPresetProfile_Click" Style="{StaticResource KruzhGhostButtonStyle}" Content="Entusiasta"
                                            Foreground="{StaticResource KruzhDangerMutedBrush}"
                                            ToolTipService.ToolTip="Tweak total: incluye cambios que pueden afectar al anticheat o la seguridad" />
                                </StackPanel>

                                <!-- Pestañas: Tweaks · Servicios · Device Manager. Los perfiles de arriba aplican sobre las tres. -->
                                <Grid Margin="0,0,0,8" BorderBrush="{StaticResource KruzhDividerHairlineBrush}" BorderThickness="0,0,0,1">
                                    <StackPanel Orientation="Horizontal" Spacing="26">
                                        <Button x:Name="OptTabTweaksBtn" Tag="Tweaks" Click="OptTab_Click" Background="Transparent" BorderThickness="0,0,0,2"
                                                BorderBrush="{StaticResource KruzhTextPrimaryBrush}" Padding="0,8" CornerRadius="0"
                                                Foreground="{StaticResource KruzhTextPrimaryBrush}" FontSize="13.5" FontWeight="SemiBold" Content="Tweaks" />
                                        <Button x:Name="OptTabServicesBtn" Tag="Services" Click="OptTab_Click" Background="Transparent" BorderThickness="0,0,0,2"
                                                BorderBrush="Transparent" Padding="0,8" CornerRadius="0"
                                                Foreground="{StaticResource KruzhTextSecondaryBrush}" FontSize="13.5" Content="Servicios" />
                                        <Button x:Name="OptTabDevicesBtn" Tag="Devices" Click="OptTab_Click" Background="Transparent" BorderThickness="0,0,0,2"
                                                BorderBrush="Transparent" Padding="0,8" CornerRadius="0"
                                                Foreground="{StaticResource KruzhTextSecondaryBrush}" FontSize="13.5" Content="Device Manager" />
                                    </StackPanel>
                                    <!-- ADR-007: Rescate, solo en la pestaña Device Manager -->
                                    <Button x:Name="DeviceRescueBtn" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed"
                                            Click="DeviceRescueBtn_Click" Style="{StaticResource KruzhGhostButtonStyle}" Content="Rescate"
                                            ToolTipService.ToolTip="Vuelve a habilitar todos los dispositivos que deshabilitó KRUZH y reinicia" />
                                </Grid>
                                <TextBlock x:Name="OptTabNoteText" Visibility="Collapsed" Margin="0,8,0,18" TextWrapping="Wrap"
                                           FontSize="12.5" Foreground="{StaticResource KruzhTextTertiaryBrush}" Text="-" />

                                <!-- Filtros: fuera de la vista (minimalismo). Se mantienen colapsados porque el código los usa:
                                     categoría = todas, compuerta = solo compatibles con esta PC, sin búsqueda. -->
                                <Grid Visibility="Collapsed">
                                    <ComboBox x:Name="TweakCategoryFilterCombo" SelectedIndex="0" SelectionChanged="TweakFilter_Changed">
                                        <ComboBoxItem Tag="ALL" Content="Todas las categorías" />
                                    </ComboBox>
                                    <ComboBox x:Name="TweakGateFilterCombo" SelectedIndex="0" SelectionChanged="TweakFilter_Changed">
                                        <ComboBoxItem Tag="APPLICABLE" Content="Compatibles con este equipo" />
                                    </ComboBox>
                                    <TextBox x:Name="TweakSearchBox" TextChanged="TweakSearchBox_TextChanged" />
                                </Grid>

                                <!-- Secciones -->
                                <ItemsControl x:Name="TweaksGroupsItemsControl" HorizontalAlignment="Stretch">
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,34" HorizontalAlignment="Stretch">
                                                <TextBlock Text="{Binding SectionTitle}" FontSize="13" Foreground="{StaticResource KruzhTextTertiaryBrush}" Margin="0,0,0,6" />

                                                <ItemsControl ItemsSource="{Binding Items}" HorizontalAlignment="Stretch">
                                                    <ItemsControl.ItemContainerStyle>
                                                        <Style TargetType="ContentPresenter">
                                                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                        </Style>
                                                    </ItemsControl.ItemContainerStyle>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <!-- Fila: [título + 1 línea] ··· [ⓘ] [toggle | opciones] · separador fino abajo -->
                                                            <Grid Padding="0,18" ColumnSpacing="18" HorizontalAlignment="Stretch"
                                                                  BorderBrush="{StaticResource KruzhDividerHairlineBrush}" BorderThickness="0,0,0,1">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" MinWidth="160" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>

                                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="4">
                                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                                        <TextBlock Text="{Binding Title}" FontSize="14.5" FontWeight="SemiBold"
                                                                                   Foreground="{StaticResource KruzhTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                                        <!-- Cambio pendiente: punto blanco discreto -->
                                                                        <Ellipse Width="6" Height="6" Fill="{StaticResource KruzhTextPrimaryBrush}" VerticalAlignment="Center"
                                                                                 Visibility="{Binding PendingVisibility}" ToolTipService.ToolTip="Cambio pendiente de aplicar" />
                                                                    </StackPanel>
                                                                </StackPanel>

                                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                                                    <!-- Desde qué perfil se aplica (Normal / Competitivo / Profesional / Entusiasta) -->
                                                                    <TextBlock Text="{Binding ProfileHintText}" FontSize="11.5" Foreground="{StaticResource KruzhTextTertiaryBrush}" VerticalAlignment="Center" />
                                                                    <Border Width="22" Height="22" CornerRadius="11" Background="Transparent"
                                                                            VerticalAlignment="Center" Tag="{Binding}"
                                                                            PointerEntered="TweakInfoIcon_PointerEntered"
                                                                            PointerExited="TweakInfoIcon_PointerExited"
                                                                            Tapped="TweakInfoIcon_Tapped">
                                                                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE946;"
                                                                                  FontSize="13" Foreground="{StaticResource KruzhTextTertiaryBrush}" />
                                                                    </Border>
                                                                    <ToggleSwitch Tag="{Binding Id}" Visibility="{Binding ToggleControlVisibility}"
                                                                                  IsOn="{Binding DesiredApplied, Mode=OneWay}"
                                                                                  IsEnabled="{Binding IsApplicableBool}"
                                                                                  OnContent="" OffContent="" MinWidth="0" Width="40"
                                                                                  VerticalAlignment="Center" Toggled="TweakCardToggleSwitch_Toggled" />
                                                                    <Border Visibility="{Binding SegmentedControlVisibility}" Background="Transparent"
                                                                            BorderBrush="{StaticResource KruzhHairlineBorderBrush}" BorderThickness="1"
                                                                            CornerRadius="6" Padding="2" VerticalAlignment="Center">
                                                                        <ItemsControl ItemsSource="{Binding Options}">
                                                                            <ItemsControl.ItemsPanel>
                                                                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2" /></ItemsPanelTemplate>
                                                                            </ItemsControl.ItemsPanel>
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate>
                                                                                    <Button Tag="{Binding CompositeTag}" Content="{Binding ShortLabel}"
                                                                                            Background="{Binding SegmentBackground}" BorderBrush="{Binding SegmentBorderBrush}"
                                                                                            Foreground="{Binding SegmentForeground}" BorderThickness="1"
                                                                                            CornerRadius="4" Padding="9,3" FontSize="11" FontWeight="SemiBold"
                                                                                            ToolTipService.ToolTip="{Binding DisplayName}" Click="SegmentedOptionBtn_Click" />
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                    </Border>
                                                                </StackPanel>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Interrupciones (avanzado): lista PCI / MSI. Se reemplaza por el auto-tune MSI (T70-T72). -->
                            <Expander x:Name="InterruptsExpander" Margin="0,10,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                      Background="Transparent" BorderBrush="{StaticResource KruzhHairlineBorderBrush}">
                                <Expander.Header>
                                    <StackPanel Spacing="2" Padding="0,8">
                                        <TextBlock Text="Interrupciones (avanzado)" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource KruzhTextPrimaryBrush}" />
                                        <TextBlock Text="Modo MSI y prioridad por dispositivo. El ajuste automático por medición llega en una próxima versión." FontSize="12" Foreground="{StaticResource KruzhTextTertiaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Expander.Header>
                                <StackPanel Spacing="14">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Click="ApplySafeMsiAllBtn_Click" Style="{StaticResource KruzhGhostButtonStyle}" Content="Activar MSI seguro" />
                                        <Button Click="ScanPciDevicesBtn_Click" Style="{StaticResource KruzhGhostButtonStyle}" Content="Re-escanear" />
                                        <Button Click="RevertAllPciIrqMsiBtn_Click" Style="{StaticResource KruzhGhostButtonStyle}" Content="Revertir" />
                                    </StackPanel>
                                    <ItemsControl x:Name="PciDevicesItemsControl">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnSpacing="16" Padding="0,12" BorderBrush="{StaticResource KruzhDividerHairlineBrush}" BorderThickness="0,0,0,1" ToolTipService.ToolTip="{Binding PnpInstanceId}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding FriendlyName}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource KruzhTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Category}" FontSize="11.5" Foreground="{StaticResource KruzhTextTertiaryBrush}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding MsiStatusText}" FontSize="12" Foreground="{StaticResource KruzhTextSecondaryBrush}" HorizontalAlignment="Right" />
                                                        <TextBlock Text="{Binding PriorityText}" FontSize="11" Foreground="{StaticResource KruzhTextTertiaryBrush}" HorizontalAlignment="Right" />
                                                    </StackPanel>
                                                    <Button Grid.Column="2" Tag="{Binding PnpInstanceId}" Click="EnableSinglePciMsiBtn_Click" IsEnabled="{Binding IsSafeForMsi}"
                                                            Style="{StaticResource KruzhGhostButtonStyle}" Content="MSI" VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Expander>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Barra de cambios pendientes (abajo, centrada con la columna) -->
                        <Border x:Name="PendingChangesStickyBar"
                                Visibility="Collapsed"
                                VerticalAlignment="Bottom"
                                HorizontalAlignment="Stretch"
                                MaxWidth="820"
                                Margin="48,0,48,20"
                                Background="#121212"
                                BorderBrush="#242424"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="18,12"
                                Translation="0,0,28">
                            <Border.Shadow>
                                <ThemeShadow />
                            </Border.Shadow>
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <Ellipse Width="6" Height="6" Fill="{StaticResource KruzhTextPrimaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="PendingChangesStatusText"
                                               Text="1 cambio pendiente"
                                               FontSize="12.5"
                                               Foreground="{StaticResource KruzhTextPrimaryBrush}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <Button x:Name="DiscardPendingChangesBtn"
                                            Click="DiscardPendingChangesBtn_Click"
                                            Style="{StaticResource KruzhGhostButtonStyle}"
                                            Content="Descartar" />
                                    <Button x:Name="ApplyPendingChangesBtn"
                                            Click="ApplyPendingChangesBtn_Click"
                                            Style="{StaticResource KruzhPrimaryButtonStyle}"
                                            Content="Aplicar cambios" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ======================================================================= -->
                    <!-- VIEW 3: GPU — ajustes de driver de la GPU detectada + perfil del driver  -->
                    <!-- Todo se arma según la GPU detectada: lo que no aplica, no se muestra.    -->
                    <!-- ======================================================================= -->
                    <ScrollViewer
                        x:Name="ViewIrqMsi"
                        Visibility="Collapsed"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled"
                        HorizontalScrollMode="Disabled">
                        <StackPanel Padding="48,34,48,40" Spacing="0" MaxWidth="1180" HorizontalAlignment="Stretch">

                            <!-- Encabezado + tarjeta de GPU detectada -->
                            <Grid Margin="0,0,0,28" ColumnSpacing="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="HARDWARE" FontSize="10.5" FontWeight="SemiBold" CharacterSpacing="80" Foreground="{StaticResource KruzhTextTertiaryBrush}" />
                                    <TextBlock Text="GPU" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource KruzhTextPrimaryBrush}" />
                                    <TextBlock Text="Ajustes de driver para tu placa de video." FontSize="13" Foreground="{StaticResource KruzhTextTertiaryBrush}" />
                                </StackPanel>
                                <Border Grid.Column="1" VerticalAlignment="Center" MinWidth="340" Padding="16,14"
                                        Background="#0C0C0C" BorderBrush="{StaticResource KruzhHairlineBorderBrush}" BorderThickness="1" CornerRadius="6">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="70" Height="44" CornerRadius="4" Background="#161616" BorderBrush="#2A2A2A" BorderThickness="1">
                                            <TextBlock x:Name="GpuVendorBadgeText" Text="GPU" FontSize="12" FontWeight="Bold" CharacterSpacing="40"
                                                       Foreground="{StaticResource KruzhTextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock x:Name="GpuDetectedNameText" Text="-" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{StaticResource KruzhTextPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="320" />
                                            <TextBlock x:Name="GpuDetectedDetailText" Text="GPU detectada" FontSize="12" Foreground="{StaticResource KruzhTextTertiaryBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Pestañas por fabricante: solo la de tu GPU está habilitada -->
                            <Grid ColumnSpacing="0" HorizontalAlignment="Left" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="GpuTabNvidia" Width="330" Height="52" Padding="22,0" BorderBrush="{StaticResource KruzhHairlineBorderBrush}" BorderThickness="1,1,0,1">
                                    <Grid>
                                        <TextBlock Text="NVIDIA" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" x:Name="GpuTabNvidiaText" />
                                        <StackPanel x:Name="GpuTabNvidiaLock" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed">
                                            <FontIcon Glyph="&#xE72E;" FontSize="12" Foreground="{StaticResource KruzhTextTertiaryBrush}" />
                                            <TextBlock Text="No compatible" FontSize="12" Foreground="{StaticResource KruzhTextTertiaryBrush}" />
                                        </StackPanel>
                                        <Border x:Name="GpuTabNvidiaUnderline" Height="2" VerticalAlignment="Bottom" Margin="0,0,0,-1" HorizontalAlignment="Left" Width="180" Background="{StaticResource KruzhTextPrimaryBrush}" Visibility="Collapsed" />
                                    </Grid>
                                </Border>
                                <Border Grid.Column="1" x:Name="GpuTabAmd" Width="330" Height="52" Padding="22,0" BorderBrush="{StaticResource KruzhHairlineBorderBrush}" BorderThickness="1">
                                    <Grid>
                                        <TextBlock Text="AMD" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" x:Name="GpuTabAmdText" />
                                        <StackPanel x:Name="GpuTabAmdLock" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed">
                                            <FontIcon Glyph="&#xE72E;" FontSize="12" Foreground="{StaticResource KruzhTextTertiaryBrush}" />
                                            <TextBlock Text="No compatible" FontSize="12" Foreground="{StaticResource KruzhTextTertiaryBrush}" />
                                        </StackPanel>
                                        <Border x:Name="GpuTabAmdUnderline" Height="2" VerticalAlignment="Bottom" Margin="0,0,0,-1" HorizontalAlignment="Left" Width="180" Background="{StaticResource KruzhTextPrimaryBrush}" Visibility="Collapsed" />
                                    </Grid>
                                </Border>
                            </Grid>
                            <TextBlock Text="Los ajustes son exclusivos de la GPU detectada." FontSize="12" Foreground="{StaticResource KruzhTextTertiaryBrush}" Margin="0,0,0,30" />

                            <!-- Dos columnas: ajustes del driver | perfil del driver -->
                            <Grid ColumnSpacing="40">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="1.2*" />
                                </Grid.ColumnDefinitions>

                                <!-- Izquierda: ajustes del driver (se generan según la GPU) -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="AJUSTES DEL DRIVER" FontSize="14" FontWeight="SemiBold" CharacterSpacing="20" Foreground="{StaticResource KruzhTextPrimaryBrush}" />
                                    <TextBlock Text="Energía y funcionamiento" FontSize="12.5" Foreground="{StaticResource KruzhTextTertiaryBrush}" Margin="0,4,0,12" />

                                    <ItemsControl x:Name="GpuDriverSettingsItemsControl">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Padding="0,18" ColumnSpacing="14" BorderBrush="{StaticResource KruzhDividerHairlineBrush}" BorderThickness="0,0,0,1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Spacing="4" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}" FontSize="14.5" FontWeight="SemiBold" Foreground="{StaticResource KruzhTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding ShortSummary}" FontSize="12.5" Foreground="{StaticResource KruzhTextTertiaryBrush}" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Width="22" Height="22" CornerRadius="11" Background="Transparent" VerticalAlignment="Center" Tag="{Binding}"
                                                            PointerEntered="TweakInfoIcon_PointerEntered" PointerExited="TweakInfoIcon_PointerExited" Tapped="TweakInfoIcon_Tapped">
                                                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE946;" FontSize="13" Foreground="{StaticResource KruzhTextTertiaryBrush}" />
                                                    </Border>
                                                    <ToggleSwitch Grid.Column="2" Tag="{Binding Id}" IsOn="{Binding IsLiveApplied, Mode=OneWay}"
                                                                  OnContent="" OffContent="" MinWidth="0" Width="40" VerticalAlignment="Center"
                                                                  Toggled="GpuDriverToggle_Toggled" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Acción: limpiar caché de shaders -->
                                    <Grid Padding="0,18" ColumnSpacing="14" BorderBrush="{StaticResource KruzhDividerHairlineBrush}" BorderThickness="0,0,0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4" VerticalAlignment="Center">
                                            <TextBlock Text="Limpiar caché de shaders" FontSize="14.5" FontWeight="SemiBold" Foreground="{StaticResource KruzhTextPrimaryBrush}" />
                                            <TextBlock Text="Útil después de actualizar el driver. El primer arranque del juego recompila." FontSize="12.5" Foreground="{StaticResource KruzhTextTertiaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button Grid.Column="1" x:Name="ClearShaderCacheBtn" Click="ClearShaderCacheBtn_Click" Style="{StaticResource KruzhGhostButtonStyle}" Content="Limpiar" MinWidth="100" VerticalAlignment="Center" />
                                    </Grid>

                                    <TextBlock x:Name="GpuDriverSettingsEmptyText" Visibility="Collapsed" Margin="0,16,0,0" TextWrapping="Wrap"
                                               FontSize="12.5" Foreground="{StaticResource KruzhTextTertiaryBrush}"
                                               Text="No hay ajustes de driver aplicables a esta GPU." />
                                </StackPanel>

                                <Rectangle Grid.Column="1" Width="1" Fill="{StaticResource KruzhDividerHairlineBrush}" />

                                <!-- Derecha: perfil del driver (.nip), de a uno -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="PERFIL DEL DRIVER" FontSize="14" FontWeight="SemiBold" CharacterSpacing="20" Foreground="{StaticResource KruzhTextPrimaryBrush}" />
                                    <TextBlock x:Name="GpuProfileSubtitleText" Text="Seleccioná un perfil por vez" FontSize="12.5" Foreground="{StaticResource KruzhTextTertiaryBrush}" Margin="0,4,0,14" />

                                    <Grid x:Name="GpuProfileCardsGrid" ColumnSpacing="12" RowSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Border x:Name="GpuProfileCompetitive" Grid.Row="0" Grid.Column="0" Tag="Competitive" Style="{StaticResource KruzhSelectableCardStyle}"
                                                Tapped="GpuProfileCard_Tapped" PointerEntered="GpuProfileCard_PointerEntered" PointerExited="GpuProfileCard_PointerExited" Loaded="GameCard_Loaded">
                                            <Grid>
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="Competitivo" FontSize="14.5" FontWeight="SemiBold" Foreground="{StaticResource KruzhTextPrimaryBrush}" />
                                                    <TextBlock Text="Máximo rendimiento, sin V-Sync ni G-SYNC" FontSize="12.5" TextWrapping="Wrap" Foreground="{StaticResource KruzhTextTertiaryBrush}" />
                                                </StackPanel>
                                                <Border x:Name="GpuProfileCompetitiveCheck" Width="16" Height="16" BorderThickness="1" BorderBrush="#5A5A5A" HorizontalAlignment="Right" VerticalAlignment="Top">
                                                    <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="#000000" Visibility="Collapsed" />
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <Border x:Name="GpuProfileCompetitiveGsync" Grid.Row="0" Grid.Column="1" Tag="CompetitiveGsync" Style="{StaticResource KruzhSelectableCardStyle}"
                                                Tapped="GpuProfileCard_Tapped" PointerEntered="GpuProfileCard_PointerEntered" PointerExited="GpuProfileCard_PointerExited" Loaded="GameCard_Loaded">
                                            <Grid>
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="Competitivo + G-SYNC" FontSize="14.5" FontWeight="SemiBold" Foreground="{StaticResource KruzhTextPrimaryBrush}" />
                                                    <TextBlock Text="Igual al anterior, con G-SYNC para monitores VRR" FontSize="12.5" TextWrapping="Wrap" Foreground="{StaticResource KruzhTextTertiaryBrush}" />
                                                </StackPanel>
                                                <Border x:Name="GpuProfileCompetitiveGsyncCheck" Width="16" Height="16" BorderThickness="1" BorderBrush="#5A5A5A" HorizontalAlignment="Right" VerticalAlignment="Top">
                                                    <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="#000000" Visibility="Collapsed" />
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <Border x:Name="GpuProfileDefault" Grid.Row="1" Grid.Column="0" Tag="Default" Style="{StaticResource KruzhSelectableCardStyle}"
                                                Tapped="GpuProfileCard_Tapped" PointerEntered="GpuProfileCard_PointerEntered" PointerExited="GpuProfileCard_PointerExited" Loaded="GameCard_Loaded">
                                            <Grid>
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="Predeterminado" FontSize="14.5" FontWeight="SemiBold" Foreground="{StaticResource KruzhTextPrimaryBrush}" />
                                                    <TextBlock Text="Vuelve al perfil base de NVIDIA" FontSize="12.5" TextWrapping="Wrap" Foreground="{StaticResource KruzhTextTertiaryBrush}" />
                                                </StackPanel>
                                                <Border x:Name="GpuProfileDefaultCheck" Width="16" Height="16" BorderThickness="1" BorderBrush="#5A5A5A" HorizontalAlignment="Right" VerticalAlignment="Top">
                                                    <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="#000000" Visibility="Collapsed" />
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- Importar un .nip propio (Profile Inspector). Queda seleccionada si se aplicó un perfil personalizado. -->
                                        <Border x:Name="GpuProfileCustom" Grid.Row="1" Grid.Column="1" Tag="Custom" Style="{StaticResource KruzhSelectableCardStyle}"
                                                Tapped="GpuProfileCard_Tapped" PointerEntered="GpuProfileCard_PointerEntered" PointerExited="GpuProfileCard_PointerExited" Loaded="GameCard_Loaded">
                                            <Grid>
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="Importar .nip" FontSize="14.5" FontWeight="SemiBold" Foreground="{StaticResource KruzhTextPrimaryBrush}" />
                                                    <TextBlock Text="Aplicá tu propio perfil de NVIDIA Profile Inspector" FontSize="12.5" TextWrapping="Wrap" Foreground="{StaticResource KruzhTextTertiaryBrush}" />
                                                </StackPanel>
                                                <Border x:Name="GpuProfileCustomCheck" Width="16" Height="16" BorderThickness="1" BorderBrush="#5A5A5A" HorizontalAlignment="Right" VerticalAlignment="Top">
                                                    <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="#000000" Visibility="Collapsed" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </Grid>

                                    <Rectangle Height="1" Fill="{StaticResource KruzhDividerHairlineBrush}" Margin="0,24,0,16" />
                                    <TextBlock Text="PERFIL DEL DRIVER" FontSize="10.5" FontWeight="SemiBold" CharacterSpacing="60" Foreground="{StaticResource KruzhTextTertiaryBrush}" />
                                    <TextBlock x:Name="GpuProfileStatusText" Text="Ningún perfil seleccionado." FontSize="12.5" Foreground="{StaticResource KruzhTextSecondaryBrush}" Margin="0,6,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>


                            <TextBlock Text="Aplicá solo los ajustes adecuados para tu uso." FontSize="12" Foreground="{StaticResource KruzhTextTertiaryBrush}" Margin="0,28,0,0" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ======================================================================= -->
                    <!-- VIEW 4: INSTALADORES (DRIVERS VERIFICADOS & PLANES DE ENERGÍA)          -->
                    <!-- ======================================================================= -->
                    <ScrollViewer
                        x:Name="ViewPowerDrivers"
                        Visibility="Collapsed"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">

                        <StackPanel Padding="48,18,48,36" Spacing="28" MaxWidth="1280" HorizontalAlignment="Stretch">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Instaladores de drivers y planes de energía" Style="{StaticResource KruzhPageTitleStyle}" />
                                    <TextBlock Text="Controladores verificados por SHA-256 para tu hardware y perfiles térmicos/frecuencia generados en tiempo real." Style="{StaticResource KruzhPageSubtitleStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Click="ImportCustomPowBtn_Click" Style="{StaticResource KruzhGhostButtonStyle}" Content="Importar archivo .pow" />
                                    <Button Click="RestorePreviousPowerPlanBtn_Click" Style="{StaticResource KruzhGhostButtonStyle}" Content="Restaurar plan Balanced" />
                                    <Button Click="RefreshDriversManifestBtn_Click" Style="{StaticResource KruzhPrimaryButtonStyle}" Content="Consultar manifiesto de drivers" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Spacing="12">
                                <TextBlock Text="CONTROLADORES RECOMENDADOS PARA TU HARDWARE" Style="{StaticResource KruzhMicroLabelStyle}" />
                                <ItemsControl x:Name="DriversItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource KruzhCardStyle}" Padding="20,16" Margin="0,0,0,8">
                                                <Grid ColumnSpacing="16">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Spacing="4">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <Border Style="{StaticResource KruzhBadgeOutlineStyle}">
                                                                <TextBlock Text="{Binding Vendor}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource KruzhTextSecondaryBrush}" />
                                                            </Border>
                                                            <TextBlock Text="{Binding HardwareGenerationOrType}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource KruzhTextPrimaryBrush}" />
                                                            <Border Style="{StaticResource KruzhBadgeActiveStyle}">
                                                                <TextBlock Text="{Binding RecommendedVersion}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource KruzhTextPrimaryBrush}" />
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding TechnicalNotes}" FontSize="12" Foreground="{StaticResource KruzhTextSecondaryBrush}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Tag="{Binding RecommendedVersion}" Click="DownloadDriverBtn_Click" Style="{StaticResource KruzhGhostButtonStyle}" VerticalAlignment="Center" Content="Descarga asistida" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel Spacing="12">
                                <TextBlock Text="PERFILES DE ENERGÍA DINÁMICOS" Style="{StaticResource KruzhMicroLabelStyle}" />
                                <ItemsControl x:Name="PowerPlansItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource KruzhSettingsCardStyle}" Margin="0,0,0,12" ToolTipService.ToolTip="{Binding TechnicalDetails}">
                                                <Grid ColumnSpacing="16">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                                            <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource KruzhTextPrimaryBrush}" />
                                                            <Border Style="{StaticResource KruzhBadgeOutlineStyle}">
                                                                <TextBlock Text="{Binding Subtitle}" FontSize="10" Foreground="{StaticResource KruzhTextSecondaryBrush}" />
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding EvaluationReason}" FontSize="12" Foreground="{StaticResource KruzhTextSecondaryBrush}" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Tag="{Binding Kind}" Click="ActivateDynamicPowerPlanBtn_Click" Style="{StaticResource KruzhGhostButtonStyle}" VerticalAlignment="Center" Content="Generar y activar" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ======================================================================= -->
                    <!-- VIEW 5: JUEGOS (BIBLIOTECA CON CARÁTULAS 1:1 ESTILO HONEST PROGRAM)      -->
                    <!-- ======================================================================= -->
                    <Grid x:Name="ViewGamesNvidia" Visibility="Collapsed">
                        <ScrollViewer x:Name="GamesScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Padding="48,18,48,36" Spacing="22" MaxWidth="1280" HorizontalAlignment="Left">
                                <!-- Head: Eyebrow + Title + Subtitle + Buscador -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="JUEGOS" Style="{StaticResource KruzhMicroLabelStyle}" />
                                        <TextBlock Text="Biblioteca" Style="{StaticResource KruzhPageTitleStyle}" />
                                        <TextBlock Text="Tus juegos, listos para jugar y optimizar." Style="{StaticResource KruzhPageSubtitleStyle}" />
                                    </StackPanel>
                                    <TextBox Grid.Column="1" x:Name="GamesSearchTextBox" Width="240"
                                             PlaceholderText="Buscar juego..."
                                             TextChanged="GamesSearchTextBox_TextChanged"
                                             Background="{StaticResource KruzhCardSurfaceBrush}"
                                             BorderBrush="{StaticResource KruzhHairlineBorderBrush}"
                                             Foreground="{StaticResource KruzhTextPrimaryBrush}"
                                             CornerRadius="9" Padding="12,8"
                                             VerticalAlignment="Center" />
                                </Grid>

                                <!-- Tabs: Todos | Instalados | Optimizados -->
                                <StackPanel Orientation="Horizontal" Spacing="24" BorderBrush="{StaticResource KruzhDividerHairlineBrush}" BorderThickness="0,0,0,1" Margin="0,4,0,8">
                                    <Button x:Name="TabGamesAll" Click="TabGames_Click" Tag="All" Style="{StaticResource KruzhTabButtonStyle}" BorderBrush="{StaticResource KruzhTextPrimaryBrush}" Foreground="{StaticResource KruzhTextPrimaryBrush}" FontWeight="SemiBold" Content="Todos" />
                                    <Button x:Name="TabGamesInstalled" Click="TabGames_Click" Tag="Installed" Style="{StaticResource KruzhTabButtonStyle}" Content="Instalados" />
                                    <Button x:Name="TabGamesOptimized" Click="TabGames_Click" Tag="Optimized" Style="{StaticResource KruzhTabButtonStyle}" Content="Optimizados" />
                                </StackPanel>

                                <!-- Library count label -->
                                <TextBlock x:Name="GamesLibraryCountText" Text="TU BIBLIOTECA" Style="{StaticResource KruzhMicroLabelStyle}" Margin="0,0,0,4" />

                                <!-- Grid of Game Cards -->
                                <GridView x:Name="GamesGridView"
                                          SelectionMode="None"
                                          IsItemClickEnabled="True"
                                          ItemClick="GamesGridView_ItemClick"
                                          Padding="0,8,0,0">
                                    <!-- Sin el fondo gris de hover/pressed del contenedor (era más grande que la card y se veía corrido).
                                         El hover lo hace la card misma (GameCard_PointerEntered/Exited). -->
                                    <GridView.Resources>
                                        <SolidColorBrush x:Key="GridViewItemBackgroundPointerOver" Color="Transparent" />
                                        <SolidColorBrush x:Key="GridViewItemBackgroundPressed" Color="Transparent" />
                                        <SolidColorBrush x:Key="GridViewItemBackgroundSelected" Color="Transparent" />
                                        <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPointerOver" Color="Transparent" />
                                        <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPressed" Color="Transparent" />
                                    </GridView.Resources>
                                    <GridView.ItemContainerStyle>
                                        <Style TargetType="GridViewItem">
                                            <Setter Property="Margin" Value="0" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="CornerRadius" Value="12" />
                                        </Style>
                                    </GridView.ItemContainerStyle>
                                    <GridView.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <ItemsWrapGrid Orientation="Horizontal" ItemWidth="188" ItemHeight="288" />
                                        </ItemsPanelTemplate>
                                    </GridView.ItemsPanel>
                                    <GridView.ItemTemplateSelector>
                                    <controls:GameTileTemplateSelector>
                                        <controls:GameTileTemplateSelector.GameTemplate>
                                        <DataTemplate>
                                            <Border Width="176" Height="276" Margin="0,0,12,12"
                                                    CornerRadius="12"
                                                    BorderBrush="{StaticResource KruzhHairlineBorderBrush}"
                                                    BorderThickness="1"
                                                    Background="{StaticResource KruzhCardSurfaceBrush}"
                                                    PointerEntered="GameCard_PointerEntered"
                                                    PointerExited="GameCard_PointerExited"
                                                    Loaded="GameCard_Loaded">
                                                <Border.TranslationTransition>
                                                    <Vector3Transition Duration="0:0:0.15" />
                                                </Border.TranslationTransition>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="38" />
                                                    </Grid.RowDefinitions>

                                                    <!-- 3:4 Cover Art -->
                                                    <Border Grid.Row="0" CornerRadius="11,11,0,0" Background="#1B1714">
                                                        <Grid>
                                                            <!-- Real cover image if available -->
                                                            <Image Source="{Binding CoverImagePath}" Stretch="UniformToFill" />

                                                            <!-- Gradient overlay at bottom for name legibility -->
                                                            <Border CornerRadius="11,11,0,0">
                                                                <Border.Background>
                                                                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                                        <GradientStop Color="#00000000" Offset="0.35" />
                                                                        <GradientStop Color="#D0000000" Offset="1.00" />
                                                                    </LinearGradientBrush>
                                                                </Border.Background>
                                                            </Border>

                                                            <!-- Game Title / Name pinned to bottom -->
                                                            <TextBlock Text="{Binding ShortName}" FontSize="13.5" FontWeight="Bold"
                                                                       Foreground="{StaticResource KruzhTextPrimaryBrush}"
                                                                       VerticalAlignment="Bottom" HorizontalAlignment="Left"
                                                                       Margin="12,0,12,10" TextTrimming="CharacterEllipsis" />
                                                        </Grid>
                                                    </Border>

                                                    <!-- Bottom Meta Bar -->
                                                    <Grid Grid.Row="1" Background="#131313" CornerRadius="0,0,11,11" Padding="11,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Ellipse Grid.Column="0" Width="6" Height="6"
                                                                 Fill="{Binding StatusDotBrush}"
                                                                 VerticalAlignment="Center" Margin="0,0,7,0" />
                                                        <TextBlock Grid.Column="1" Text="{Binding StatusText}"
                                                                   FontSize="11" Foreground="{StaticResource KruzhTextSecondaryBrush}"
                                                                   VerticalAlignment="Center" />
                                                        <Border Grid.Column="2" Visibility="{Binding OptimizedBadgeVisibility}"
                                                                Background="{StaticResource KruzhPositiveBgBrush}"
                                                                BorderBrush="{StaticResource KruzhPositiveBorderBrush}"
                                                                BorderThickness="1" CornerRadius="4" Padding="5,1" VerticalAlignment="Center">
                                                            <TextBlock Text="OPT" FontSize="9" FontWeight="Bold" Foreground="{StaticResource KruzhPositiveBrush}" />
                                                        </Border>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                        </controls:GameTileTemplateSelector.GameTemplate>
                                        <controls:GameTileTemplateSelector.AddTemplate>
                                            <!-- "+ Agregar juego": último ítem de la grilla, al lado del último juego (antes era Footer y quedaba abajo). -->
                                            <DataTemplate>
                                                <Border Tag="AddGame" Width="176" Height="276" Margin="0,0,12,12"
                                                        CornerRadius="12"
                                                        BorderBrush="#333333" BorderThickness="1"
                                                        Background="Transparent"
                                                        PointerEntered="GameCard_PointerEntered"
                                                        PointerExited="GameCard_PointerExited"
                                                        Loaded="GameCard_Loaded">
                                                    <Border.TranslationTransition>
                                                        <Vector3Transition Duration="0:0:0.15" />
                                                    </Border.TranslationTransition>
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                                                        <FontIcon Glyph="&#xE710;" FontSize="24" Foreground="{StaticResource KruzhTextTertiaryBrush}" />
                                                        <TextBlock Text="Agregar juego" FontSize="12" Foreground="{StaticResource KruzhTextTertiaryBrush}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </controls:GameTileTemplateSelector.AddTemplate>
                                    </controls:GameTileTemplateSelector>
                                    </GridView.ItemTemplateSelector>
                                </GridView>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Modal de Optimización del Juego (Estilo Honest CS2 1:1) -->
                        <Grid x:Name="GameOptimizationModalOverlay" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <Border Background="#CC070707" Tapped="CloseGameModal_Tapped" />

                            <Border Width="640" MaxHeight="780" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Background="{StaticResource KruzhCardSurfaceBrush}"
                                    BorderBrush="{StaticResource KruzhHairlineBorderBrush}"
                                    BorderThickness="1" CornerRadius="14" Translation="0,0,32">
                                <Border.Shadow>
                                    <ThemeShadow />
                                </Border.Shadow>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Hero Header -->
                                    <Border Grid.Row="0" Height="110" CornerRadius="13,13,0,0">
                                        <Grid>
                                            <Border x:Name="ModalHeroBackground" Background="#2A1A2E" />
                                            <Border>
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#99191919" Offset="0.0" />
                                                        <GradientStop Color="#E6191919" Offset="1.0" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>

                                            <Grid Padding="22,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Width="54" Height="72" CornerRadius="7"
                                                        BorderBrush="#444444" BorderThickness="1"
                                                        VerticalAlignment="Center" Margin="0,0,16,0"
                                                        Background="#2A2410">
                                                    <Image x:Name="ModalMiniCoverImage" Stretch="UniformToFill" />
                                                </Border>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="OPTIMIZACIONES DEL JUEGO" FontSize="9.5" FontWeight="SemiBold"
                                                               CharacterSpacing="60" Foreground="{StaticResource KruzhTextSecondaryBrush}" />
                                                    <TextBlock x:Name="ModalGameTitleText" Text="CS2" FontSize="22" FontWeight="Bold"
                                                               Foreground="{StaticResource KruzhTextPrimaryBrush}" />
                                                </StackPanel>

                                                <Button Grid.Column="2" Click="ModalChangeCoverBtn_Click"
                                                        Style="{StaticResource KruzhGhostButtonStyle}"
                                                        Content="Cambiar portada" VerticalAlignment="Center" Margin="0,0,12,0" />

                                                <Button Grid.Column="3" Click="CloseGameModal_Click"
                                                        Background="Transparent" BorderThickness="0" Padding="8"
                                                        Foreground="{StaticResource KruzhTextSecondaryBrush}" VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                                                </Button>
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <!-- Modal Body -->
                                    <ScrollViewer Grid.Row="1" Padding="22,12,22,8" MaxHeight="520">
                                        <StackPanel Spacing="0">
                                            <!--
                                              Solo opciones que (1) hacen algo de verdad y (2) aplican a ESTA PC.
                                              Fuera: FSO off (en Windows 11 FSO/flip model es mejor que FSE), y P-cores / Un CCD /
                                              Boost / Excluir Core 0 (no estaban implementadas; la afinidad por topología llega en T34
                                              y se mostrará solo en CPUs híbridas o Ryzen dual-CCD).
                                            -->

                                            <!-- Prioridad alta CPU/IO (IFEO PerfOptions) -->
                                            <Grid Padding="0,13" BorderBrush="{StaticResource KruzhDividerHairlineBrush}" BorderThickness="0,0,0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="Prioridad alta de CPU y disco" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource KruzhTextPrimaryBrush}" />
                                                    <TextBlock Text="Windows le da prioridad al juego frente a procesos de fondo (IFEO, por registro)." FontSize="11.5" TextWrapping="Wrap" Foreground="{StaticResource KruzhTextSecondaryBrush}" />
                                                </StackPanel>
                                                <ToggleSwitch Grid.Column="1" x:Name="ModalIfeoPriorityToggle" OnContent="" OffContent="" MinWidth="0" Width="40" VerticalAlignment="Center" />
                                            </Grid>

                                            <!-- QoS DSCP 46 -->
                                            <Grid Padding="0,13" BorderBrush="{StaticResource KruzhDividerHairlineBrush}" BorderThickness="0,0,0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="Prioridad de red (QoS DSCP 46)" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource KruzhTextPrimaryBrush}" />
                                                    <TextBlock Text="Marca el tráfico UDP del juego como prioritario. Sirve si tu router tiene QoS/SQM." FontSize="11.5" TextWrapping="Wrap" Foreground="{StaticResource KruzhTextSecondaryBrush}" />
                                                </StackPanel>
                                                <ToggleSwitch Grid.Column="1" x:Name="ModalQosToggle" OnContent="" OffContent="" MinWidth="0" Width="40" VerticalAlignment="Center" />
                                            </Grid>

                                            <!-- Preferencia de GPU: solo visible con 2+ GPUs físicas -->
                                            <Grid x:Name="ModalGpuPrefRow" Padding="0,13" BorderBrush="{StaticResource KruzhDividerHairlineBrush}" BorderThickness="0,0,0,1" Visibility="Collapsed">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="Usar la GPU dedicada" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource KruzhTextPrimaryBrush}" />
                                                    <TextBlock Text="Detectamos más de una GPU: fuerza la de alto rendimiento para este juego." FontSize="11.5" TextWrapping="Wrap" Foreground="{StaticResource KruzhTextSecondaryBrush}" />
                                                </StackPanel>
                                                <ToggleSwitch Grid.Column="1" x:Name="ModalGpuPrefToggle" OnContent="" OffContent="" MinWidth="0" Width="40" VerticalAlignment="Center" />
                                            </Grid>

                                            <!-- Executable path section -->
                                            <StackPanel Margin="0,16,0,8" Spacing="7">
                                                <TextBlock Text="EJECUTABLE DEL JUEGO (.EXE)" FontSize="9.5" FontWeight="SemiBold"
                                                           CharacterSpacing="50" Foreground="{StaticResource KruzhTextTertiaryBrush}" />
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Background="#121212" BorderBrush="{StaticResource KruzhHairlineBorderBrush}"
                                                            BorderThickness="1" CornerRadius="8" Padding="12,9">
                                                        <TextBlock x:Name="ModalExePathText" Text="-" FontSize="11.5" FontFamily="Consolas"
                                                                   Foreground="{StaticResource KruzhTextSecondaryBrush}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </Border>
                                                    <Button Grid.Column="1" Click="ModalSelectExeBtn_Click"
                                                            Style="{StaticResource KruzhGhostButtonStyle}" Content="Seleccionar" />
                                                </Grid>
                                                <TextBlock x:Name="ModalAnticheatNoteText"
                                                           Text="Protección anticheat: configurado de forma pasiva en registro (IFEO y QoS)."
                                                           FontSize="11" Foreground="{StaticResource KruzhPositiveBrush}" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                    </ScrollViewer>

                                    <!-- Footer -->
                                    <Grid Grid.Row="2" ColumnSpacing="12" Padding="22,14,22,22" BorderBrush="{StaticResource KruzhDividerHairlineBrush}" BorderThickness="0,1,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" x:Name="ModalRevertBtn" Click="ModalRevertBtn_Click"
                                                Style="{StaticResource KruzhGhostButtonStyle}"
                                                HorizontalAlignment="Stretch" Content="Revertir" Padding="14,12" />
                                        <Button Grid.Column="1" x:Name="ModalApplyBtn" Click="ModalApplyBtn_Click"
                                                Style="{StaticResource KruzhPrimaryButtonStyle}"
                                                HorizontalAlignment="Stretch" Content="Aplicar" Padding="14,12" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- ======================================================================= -->
                    <!-- VIEW 6: BIOS / NVRAM ADVISORY (SCEWIN) — 1:1 REWORK ESTILO HONEST        -->
                    <!-- ======================================================================= -->
                    <ScrollViewer
                        x:Name="ViewBiosNvram"
                        Visibility="Collapsed"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled"
                        HorizontalScrollMode="Disabled">

                        <StackPanel Padding="48,18,48,36" Spacing="24" MaxWidth="1280" HorizontalAlignment="Stretch" AllowDrop="True" DragOver="NvramPanel_DragOver" Drop="NvramPanel_Drop">
                            <!-- Head: Eyebrow + Title + Subtitle + Action Buttons -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="3">
                                    <TextBlock Text="FIRMWARE" Style="{StaticResource KruzhMicroLabelStyle}" />
                                    <TextBlock Text="BIOS / NVRAM" Style="{StaticResource KruzhPageTitleStyle}" />
                                    <TextBlock Text="Importá tu nvram.txt (AMI SCEWIN) y te decimos qué settings están bien y cuáles conviene cambiar. Solo lectura: los cambios los hacés vos en la BIOS." Style="{StaticResource KruzhPageSubtitleStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <Button Click="ImportNvramFileBtn_Click" Style="{StaticResource KruzhPrimaryButtonStyle}" Content="Importar nvram.txt" />
                                </StackPanel>
                            </Grid>

                            <!-- 2 Columns: Acciones (Left) and Firmware Info (Right) -->
                            <Grid ColumnSpacing="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="240" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Left Column: Action Buttons Stack -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="01 / REVISAR" FontSize="10" FontWeight="SemiBold" CharacterSpacing="60" Foreground="{StaticResource KruzhTextTertiaryBrush}" Margin="0,0,0,10" />
                                    <Button Click="ImportNvramFileBtn_Click" Style="{StaticResource KruzhPrimaryButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Content="Importar nvram.txt" Margin="0,0,0,8" />
                                    <Button Click="ViewCurrentBiosConfigBtn_Click" Style="{StaticResource KruzhGhostButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Content="Ver configuración" Margin="0,0,0,8" />
                                    <Button Click="OpenScewinFolderBtn_Click" Style="{StaticResource KruzhGhostButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Content="Abrir carpeta" Margin="0,0,0,8" />

                                    <TextBlock Text="02 / SCEWIN" FontSize="10" FontWeight="SemiBold" CharacterSpacing="60" Foreground="{StaticResource KruzhTextTertiaryBrush}" Margin="0,16,0,10" />
                                    <Button Click="DownloadScewinBtn_Click" Style="{StaticResource KruzhGhostButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Content="Cómo exportar nvram.txt" Margin="0,0,0,8" />
                                    <Button Click="VerifyScewinHashBtn_Click" Style="{StaticResource KruzhGhostButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Content="Verificar hash de SCEWIN" Margin="0,0,0,8" />
                                </StackPanel>

                                <!-- Right Column: Firmware Info Card -->
                                <Border Grid.Column="1" Style="{StaticResource KruzhCardStyle}" Padding="0">
                                    <StackPanel>
                                        <!-- Top Header: Chip AMI + Firmware Detectado -->
                                        <Grid Padding="20,18">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="40" Height="40" CornerRadius="9" Background="#202020" BorderBrush="{StaticResource KruzhHairlineBorderBrush}" BorderThickness="1" Margin="0,0,14,0" VerticalAlignment="Center">
                                                <TextBlock Text="AMI" FontSize="11" FontWeight="Bold" Foreground="{StaticResource KruzhTextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="FIRMWARE DETECTADO" FontSize="9.5" FontWeight="SemiBold" CharacterSpacing="50" Foreground="{StaticResource KruzhTextTertiaryBrush}" />
                                                <TextBlock x:Name="BiosVendorSummaryText" Text="American Megatrends — AMI Aptio V" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource KruzhTextPrimaryBrush}" />
                                            </StackPanel>
                                        </Grid>

                                        <Rectangle Fill="{StaticResource KruzhDividerHairlineBrush}" Height="1" />

                                        <!-- Rows with Hairline Divider -->
                                        <Grid Padding="20,13">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Placa" FontSize="13" Foreground="{StaticResource KruzhTextSecondaryBrush}" />
                                            <TextBlock Grid.Column="1" x:Name="BiosMotherboardText" Text="-" FontSize="13" FontWeight="Medium" Foreground="{StaticResource KruzhTextPrimaryBrush}" />
                                        </Grid>
                                        <Rectangle Fill="{StaticResource KruzhDividerHairlineBrush}" Height="1" />

                                        <Grid Padding="20,13">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Versión BIOS" FontSize="13" Foreground="{StaticResource KruzhTextSecondaryBrush}" />
                                            <TextBlock Grid.Column="1" x:Name="BiosVersionText" Text="-" FontSize="13" FontWeight="Medium" Foreground="{StaticResource KruzhTextPrimaryBrush}" />
                                        </Grid>
                                        <Rectangle Fill="{StaticResource KruzhDividerHairlineBrush}" Height="1" />

                                        <Grid Padding="20,13">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Compatibilidad SCEWIN" FontSize="13" Foreground="{StaticResource KruzhTextSecondaryBrush}" />
                                            <TextBlock Grid.Column="1" x:Name="BiosScewinCompatibilityText" Text="Compatible ✓" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource KruzhPositiveBrush}" />
                                        </Grid>
                                        <Rectangle Fill="{StaticResource KruzhDividerHairlineBrush}" Height="1" />

                                        <Grid Padding="20,13">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Parámetros encontrados" FontSize="13" Foreground="{StaticResource KruzhTextSecondaryBrush}" />
                                            <TextBlock Grid.Column="1" x:Name="BiosParamsFoundText" Text="—" FontSize="13" FontWeight="Medium" Foreground="{StaticResource KruzhTextPrimaryBrush}" />
                                        </Grid>
                                        <Rectangle Fill="{StaticResource KruzhDividerHairlineBrush}" Height="1" />

                                        <Grid Padding="20,13">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Óptimos / Sugeridos" FontSize="13" Foreground="{StaticResource KruzhTextSecondaryBrush}" />
                                            <TextBlock Grid.Column="1" x:Name="BiosOptimosSugeridosText" Text="Importá tu nvram.txt" FontSize="13" FontWeight="Medium" Foreground="{StaticResource KruzhTextPrimaryBrush}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!--
                              Guía del procedimiento. Cada paso es UN TextBlock con Runs y TextWrapping: antes eran StackPanels
                              horizontales que reportaban un ancho mayor a la ventana y corrían toda la vista a la derecha.
                            -->
                            <Border Style="{StaticResource KruzhCardStyle}" Padding="20,18">
                                <StackPanel Spacing="14">
                                    <TextBlock Text="PROCEDIMIENTO MANUAL" Style="{StaticResource KruzhMicroLabelStyle}" />

                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="20" Height="20" CornerRadius="10" Background="#202020" BorderBrush="{StaticResource KruzhHairlineBorderBrush}" BorderThickness="1" VerticalAlignment="Top" Margin="0,1,0,0">
                                            <TextBlock Text="1" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource KruzhTextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource KruzhTextSecondaryBrush}">
                                            <Run Text="Backup obligatorio." FontWeight="SemiBold" Foreground="{StaticResource KruzhTextPrimaryBrush}" />
                                            <Run Text=" Abrí CMD como Administrador y ejecutá " />
                                            <Run Text="SCEWIN_64.exe /o /s nvram_backup_original.txt" FontFamily="Consolas" Foreground="#CFD2C8" />
                                            <Run Text=" — guardalo en un pendrive." />
                                        </TextBlock>
                                    </Grid>

                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="20" Height="20" CornerRadius="10" Background="#202020" BorderBrush="{StaticResource KruzhHairlineBorderBrush}" BorderThickness="1" VerticalAlignment="Top" Margin="0,1,0,0">
                                            <TextBlock Text="2" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource KruzhTextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource KruzhTextSecondaryBrush}">
                                            <Run Text="Analizá." FontWeight="SemiBold" Foreground="{StaticResource KruzhTextPrimaryBrush}" />
                                            <Run Text=" Importá tu " />
                                            <Run Text="nvram.txt" FontFamily="Consolas" Foreground="#CFD2C8" />
                                            <Run Text=" acá arriba y revisá qué settings están bien y cuáles cambiar." />
                                        </TextBlock>
                                    </Grid>

                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="20" Height="20" CornerRadius="10" Background="#202020" BorderBrush="{StaticResource KruzhHairlineBorderBrush}" BorderThickness="1" VerticalAlignment="Top" Margin="0,1,0,0">
                                            <TextBlock Text="3" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource KruzhTextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource KruzhTextSecondaryBrush}">
                                            <Run Text="Cambiá vos los valores." FontWeight="SemiBold" Foreground="{StaticResource KruzhTextPrimaryBrush}" />
                                            <Run Text=" KRUZH LATENCY no modifica la BIOS: aplicá cada recomendación desde el setup de tu BIOS, bajo tu responsabilidad." />
                                        </TextBlock>
                                    </Grid>

                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="20" Height="20" CornerRadius="10" Background="#202020" BorderBrush="{StaticResource KruzhHairlineBorderBrush}" BorderThickness="1" VerticalAlignment="Top" Margin="0,1,0,0">
                                            <TextBlock Text="4" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource KruzhTextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource KruzhTextSecondaryBrush}">
                                            <Run Text="Recuperación." FontWeight="SemiBold" Foreground="{StaticResource KruzhTextPrimaryBrush}" />
                                            <Run Text=" Si no bootea: Clear CMOS (jumper o botón trasero) o reflash con programador SPI CH341A." />
                                        </TextBlock>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Analyzed Firmware Parameters List -->
                            <StackPanel Spacing="12">
                                <TextBlock Text="PARÁMETROS DE FIRMWARE ANALIZADOS" Style="{StaticResource KruzhMicroLabelStyle}" />

                                <!-- Estado vacío: no se muestra NINGÚN setting hasta que el usuario importa su nvram.txt -->
                                <Border x:Name="NvramEmptyStatePanel" Style="{StaticResource KruzhCardStyle}" Padding="24,28">
                                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                                        <TextBlock x:Name="NvramEmptyStateTitle" Text="Todavía no importaste tu nvram.txt" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource KruzhTextPrimaryBrush}" HorizontalAlignment="Center" />
                                        <TextBlock x:Name="NvramEmptyStateDetail" Text="Exportalo con SCEWIN y arrastralo acá o usá «Importar nvram.txt». Solo vas a ver los settings que existen en tu BIOS." FontSize="12.5" Foreground="{StaticResource KruzhTextSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="560" />
                                    </StackPanel>
                                </Border>

                                <Border x:Name="NvramResultsPanel" Style="{StaticResource KruzhCardStyle}" Padding="0" Visibility="Collapsed">
                                    <ItemsControl x:Name="NvramFindingsItemsControl">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <Grid ColumnSpacing="16" Padding="18,15">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="170" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal" Spacing="9">
                                                                <TextBlock Text="{Binding QuestionName}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource KruzhTextPrimaryBrush}" />
                                                                <Border Background="Transparent" BorderBrush="{Binding ImpactBadgeBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="7,1">
                                                                    <TextBlock Text="{Binding Impact}" FontSize="9.5" FontWeight="Bold" Foreground="{Binding ImpactBadgeForeground}" />
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding TechnicalReason}" FontSize="11.5" Foreground="{StaticResource KruzhTextSecondaryBrush}" TextWrapping="Wrap" MaxWidth="580" />
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                            <TextBlock Text="ACTUAL → RECOMENDADO" FontSize="9.5" FontWeight="SemiBold" CharacterSpacing="40" Foreground="{StaticResource KruzhTextTertiaryBrush}" HorizontalAlignment="Right" />
                                                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" Margin="0,2,0,0">
                                                                <TextBlock Text="{Binding CurrentValue}" FontSize="12.5" Foreground="{StaticResource KruzhTextSecondaryBrush}" />
                                                                <TextBlock Text="→" FontSize="12" Foreground="{StaticResource KruzhTextTertiaryBrush}" />
                                                                <TextBlock Text="{Binding RecommendedValue}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource KruzhTextPrimaryBrush}" />
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <Border Grid.Column="3" VerticalAlignment="Center" Margin="10,0,0,0" CornerRadius="5" Padding="9,3"
                                                                BorderThickness="1" BorderBrush="{Binding ImpactBadgeBorderBrush}">
                                                            <TextBlock Text="{Binding NvramStatusText}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource KruzhTextPrimaryBrush}" />
                                                        </Border>
                                                    </Grid>
                                                    <Rectangle Fill="{StaticResource KruzhDividerHairlineBrush}" Height="1" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ======================================================================= -->
                    <!-- VIEW 7: MONITOR EN VIVO & JOURNAL TRANSACCIONAL                         -->
                    <!-- ======================================================================= -->
                    <ScrollViewer
                        x:Name="ViewMonitorAudit"
                        Visibility="Collapsed"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled"
                        HorizontalScrollMode="Disabled">
                        <StackPanel Padding="48,34,48,40" Spacing="0" MaxWidth="1100" HorizontalAlignment="Stretch">

                            <!-- Encabezado -->
                            <StackPanel Spacing="6" Margin="0,0,0,30">
                                <TextBlock Text="SISTEMA" FontSize="10.5" FontWeight="SemiBold" CharacterSpacing="80" Foreground="{StaticResource KruzhTextTertiaryBrush}" />
                                <TextBlock Text="Monitor" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource KruzhTextPrimaryBrush}" />
                                <TextBlock Text="Cómo está respondiendo tu PC ahora mismo, y qué cambios hizo KRUZH LATENCY." FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource KruzhTextTertiaryBrush}" />
                            </StackPanel>

                            <!-- 4 indicadores en vivo: valor + qué significa -->
                            <Grid ColumnSpacing="12" Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Padding="18,16" Background="#0C0C0C" BorderBrush="{StaticResource KruzhHairlineBorderBrush}" BorderThickness="1" CornerRadius="6"
                                        ToolTipService.ToolTip="Cada cuánto el kernel atiende temporizadores. En reposo Windows usa 15,6 ms; los juegos piden 1 ms o 0,5 ms solos al abrirse.">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Precisión del timer" FontSize="12" Foreground="{StaticResource KruzhTextTertiaryBrush}" />
                                        <TextBlock x:Name="MonTimerValue" Text="-" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource KruzhTextPrimaryBrush}" />
                                        <TextBlock x:Name="MonTimerStatus" Text="-" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource KruzhTextTertiaryBrush}" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Padding="18,16" Background="#0C0C0C" BorderBrush="{StaticResource KruzhHairlineBorderBrush}" BorderThickness="1" CornerRadius="6"
                                        ToolTipService.ToolTip="Porcentaje del procesador que se va en atender interrupciones y DPC de drivers. Si sube mucho, un driver está generando latencia.">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Interrupciones y DPC" FontSize="12" Foreground="{StaticResource KruzhTextTertiaryBrush}" />
                                        <TextBlock x:Name="MonDpcValue" Text="-" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource KruzhTextPrimaryBrush}" />
                                        <TextBlock x:Name="MonDpcStatus" Text="-" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource KruzhTextTertiaryBrush}" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Padding="18,16" Background="#0C0C0C" BorderBrush="{StaticResource KruzhHairlineBorderBrush}" BorderThickness="1" CornerRadius="6">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Uso de CPU" FontSize="12" Foreground="{StaticResource KruzhTextTertiaryBrush}" />
                                        <TextBlock x:Name="MonCpuValue" Text="-" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource KruzhTextPrimaryBrush}" />
                                        <TextBlock x:Name="MonCpuStatus" Text="-" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource KruzhTextTertiaryBrush}" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="3" Padding="18,16" Background="#0C0C0C" BorderBrush="{StaticResource KruzhHairlineBorderBrush}" BorderThickness="1" CornerRadius="6">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Uso de GPU" FontSize="12" Foreground="{StaticResource KruzhTextTertiaryBrush}" />
                                        <TextBlock x:Name="MonGpuValue" Text="-" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource KruzhTextPrimaryBrush}" />
                                        <TextBlock x:Name="MonGpuStatus" Text="-" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource KruzhTextTertiaryBrush}" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Un solo gráfico: interrupciones y DPC, últimos 60 s -->
                            <Border Padding="18,16" Background="#0C0C0C" BorderBrush="{StaticResource KruzhHairlineBorderBrush}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,40">
                                <StackPanel Spacing="10">
                                    <Grid>
                                        <TextBlock Text="Interrupciones y DPC · últimos 60 segundos" FontSize="12.5" Foreground="{StaticResource KruzhTextSecondaryBrush}" />
                                        <TextBlock x:Name="LiveMonitorStatsText" Text="-" FontSize="12" Foreground="{StaticResource KruzhTextTertiaryBrush}" HorizontalAlignment="Right" />
                                    </Grid>
                                    <Grid Height="130">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="34" Margin="0,0,8,0">
                                            <TextBlock x:Name="MonChartMaxLabel" Text="5 %" FontSize="10.5" Foreground="{StaticResource KruzhTextTertiaryBrush}" VerticalAlignment="Top" HorizontalAlignment="Right" />
                                            <TextBlock Text="0 %" FontSize="10.5" Foreground="{StaticResource KruzhTextTertiaryBrush}" VerticalAlignment="Bottom" HorizontalAlignment="Right" />
                                        </Grid>
                                        <Border Grid.Column="1" BorderBrush="{StaticResource KruzhDividerHairlineBrush}" BorderThickness="1,0,0,1">
                                            <Canvas x:Name="LiveTelemetryCanvas" Height="128">
                                                <Polyline x:Name="DpcChartPolyline" Stroke="{StaticResource KruzhTextPrimaryBrush}" StrokeThickness="1.5" Opacity="0.85" />
                                            </Canvas>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Drivers con más latencia (ETW: DPC + ISR por driver, a pedido) -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Drivers con más latencia" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource KruzhTextPrimaryBrush}" />
                                    <TextBlock Text="Mide cuánto tarda cada driver en atender sus interrupciones (DPC/ISR). Iniciá la medición, jugá una partida y volvé a detenerla: los resultados se actualizan en vivo." FontSize="12.5" TextWrapping="Wrap" Foreground="{StaticResource KruzhTextTertiaryBrush}" />
                                </StackPanel>
                                <Button Grid.Column="1" x:Name="AnalyzeDpcDriversBtn" Click="AnalyzeDpcDriversBtn_Click" Style="{StaticResource KruzhGhostButtonStyle}"
                                        Content="Iniciar medición" VerticalAlignment="Center" MinWidth="140" />
                            </Grid>

                            <!-- Estado de la medición: altura fija para que nada se corra mientras mide -->
                            <Grid Height="22" Margin="0,10,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Ellipse x:Name="DpcLiveDot" Width="7" Height="7" Fill="#CD6666" Visibility="Collapsed" VerticalAlignment="Center" />
                                    <TextBlock x:Name="DpcStatusText" Text="Listo para medir." FontSize="12" Foreground="{StaticResource KruzhTextTertiaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>

                            <!-- Veredicto + números generales -->
                            <Border x:Name="DpcSummaryPanel" Visibility="Collapsed" Margin="0,14,0,6" Padding="18,14"
                                    Background="#0C0C0C" BorderBrush="{StaticResource KruzhHairlineBorderBrush}" BorderThickness="1" CornerRadius="6">
                                <StackPanel Spacing="6">
                                    <TextBlock x:Name="DpcVerdictText" Text="-" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource KruzhTextPrimaryBrush}" />
                                    <TextBlock x:Name="DpcSummaryText" Text="-" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource KruzhTextTertiaryBrush}" />
                                </StackPanel>
                            </Border>

                            <!-- Encabezado de columnas -->
                            <Grid x:Name="DpcDriversHeader" Visibility="Collapsed" Padding="0,10,0,6" ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Driver" FontSize="11.5" Foreground="{StaticResource KruzhTextTertiaryBrush}" />
                                <TextBlock Grid.Column="1" Text="Peor tiempo" FontSize="11.5" Foreground="{StaticResource KruzhTextTertiaryBrush}" HorizontalAlignment="Right"
                                           ToolTipService.ToolTip="La ejecución más larga de un DPC o interrupción de este driver. Arriba de 1000 µs se nota como micro-stutter." />
                                <TextBlock Grid.Column="2" Text="Promedio" FontSize="11.5" Foreground="{StaticResource KruzhTextTertiaryBrush}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="3" Text="Llamadas" FontSize="11.5" Foreground="{StaticResource KruzhTextTertiaryBrush}" HorizontalAlignment="Right" />
                            </Grid>

                            <ItemsControl x:Name="DpcDriversItemsControl" Margin="0,0,0,40">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="0,12" ColumnSpacing="14" BorderBrush="{StaticResource KruzhDividerHairlineBrush}" BorderThickness="0,0,0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="110" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource KruzhTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding FileName}" FontSize="11.5" Foreground="{StaticResource KruzhTextTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding MaxText}" FontSize="13" FontWeight="SemiBold" Foreground="{Binding MaxBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding AvgText}" FontSize="13" Foreground="{StaticResource KruzhTextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{Binding CountText}" FontSize="13" Foreground="{StaticResource KruzhTextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Cambios aplicados (journal) en lenguaje humano -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Cambios aplicados" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource KruzhTextPrimaryBrush}" />
                                    <TextBlock Text="Todo lo que KRUZH LATENCY modificó, con el valor original guardado para volver atrás." FontSize="12.5" TextWrapping="Wrap" Foreground="{StaticResource KruzhTextTertiaryBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Button x:Name="RevertAllFromJournalBtn" Click="RevertAllFromJournalBtn_Click" Style="{StaticResource KruzhGhostButtonStyle}" Content="Revertir todo" />
                                    <Button Background="Transparent" BorderThickness="0" Padding="8" Foreground="{StaticResource KruzhTextSecondaryBrush}" ToolTipService.ToolTip="Más opciones">
                                        <FontIcon Glyph="&#xE712;" FontSize="14" />
                                        <Button.Flyout>
                                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                <MenuFlyoutItem Text="Abrir carpeta de backups" Click="OpenJournalFolderBtn_Click" />
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <TextBlock x:Name="JournalEmptyText" Text="Todavía no aplicaste cambios." Visibility="Collapsed" Margin="0,18,0,0"
                                       FontSize="12.5" Foreground="{StaticResource KruzhTextTertiaryBrush}" />

                            <ItemsControl x:Name="JournalEntriesItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="0,16" ColumnSpacing="14" BorderBrush="{StaticResource KruzhDividerHairlineBrush}" BorderThickness="0,0,0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource KruzhTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{StaticResource KruzhTextTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Tag="{Binding TweakId}" Click="RevertSingleJournalEntryBtn_Click"
                                                    Style="{StaticResource KruzhGhostButtonStyle}" Content="Revertir" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                    <!-- ======================================================================= -->
                    <!-- VIEW 8: CONFIGURACIÓN (PARÁMETROS DE HARDWARE, SPECS & LICENCIA)        -->
                    <!-- ======================================================================= -->
                    <ScrollViewer
                        x:Name="ViewConfig"
                        Visibility="Collapsed"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">

                        <StackPanel Padding="48,18,48,36" Spacing="28" MaxWidth="1280" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Configuración" Style="{StaticResource KruzhPageTitleStyle}" />
                                <TextBlock Text="Parámetros de hardware, topología completa del equipo y activación de licencia comercial." Style="{StaticResource KruzhPageSubtitleStyle}" />
                            </StackPanel>

                            <StackPanel Spacing="12">
                                <TextBlock Text="PARÁMETROS DE HARDWARE Y PERIFÉRICOS" Style="{StaticResource KruzhMicroLabelStyle}" />

                                <StackPanel Spacing="10">
                                    <Border Style="{StaticResource KruzhCardStyle}" Padding="20,16">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Grid.Column="0" FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE945;" FontSize="18" Foreground="{StaticResource KruzhTextSecondaryBrush}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="Régimen de frecuencia del procesador" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource KruzhTextPrimaryBrush}" />
                                                <TextBlock Text="Define si tu CPU opera con multiplicador estático (All-Core Overclock fijo sin PBO) o con boost dinámico (AMD PBO + Curve Optimizer / Intel Turbo)." FontSize="12" Foreground="{StaticResource KruzhTextSecondaryBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <ComboBox x:Name="CpuClockingModeCombo" Grid.Column="2" SelectionChanged="CpuClockingModeCombo_SelectionChanged" MinWidth="320" VerticalAlignment="Center">
                                                <ComboBoxItem Tag="StaticAllCore" Content="All-Core Overclock Fijo (ej. 4.70 GHz sin PBO)" />
                                                <ComboBoxItem Tag="DynamicBoost" Content="Boost Dinámico (PBO + Curve Optimizer / Turbo)" />
                                            </ComboBox>
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource KruzhCardStyle}" Padding="20,16">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Grid.Column="0" FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE962;" FontSize="18" Foreground="{StaticResource KruzhTextSecondaryBrush}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="Frecuencia de sondeo del mouse (Polling Rate)" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource KruzhTextPrimaryBrush}" />
                                                <TextBlock Text="Ajusta automáticamente el tamaño del buffer MouseDataQueueSize para evitar pérdida de paquetes en sensores 1000, 2000, 4000 u 8000 Hz." FontSize="12" Foreground="{StaticResource KruzhTextSecondaryBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <ComboBox x:Name="MousePollingHzCombo" Grid.Column="2" SelectionChanged="MousePollingHzCombo_SelectionChanged" MinWidth="240" VerticalAlignment="Center">
                                                <ComboBoxItem Tag="1000" Content="1000 Hz (Buffer 16)" />
                                                <ComboBoxItem Tag="2000" Content="2000 Hz (Buffer 32)" />
                                                <ComboBoxItem Tag="4000" Content="4000 Hz (Buffer 64)" />
                                                <ComboBoxItem Tag="8000" Content="8000 Hz (Buffer 128)" />
                                            </ComboBox>
                                        </Grid>
                                    </Border>

                                    <TextBlock x:Name="CpuClockingModeExplainText" FontSize="11" Foreground="{StaticResource KruzhTextTertiaryBrush}" Margin="4,2,0,0" />
                                    <TextBlock x:Name="MousePollingExplainText" Visibility="Collapsed" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Spacing="12">
                                <TextBlock Text="ESPECIFICACIONES Y TOPOLOGÍA DETALLADA" Style="{StaticResource KruzhMicroLabelStyle}" />

                                <Grid ColumnSpacing="18" RowSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource KruzhCardStyle}" Padding="20,16">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="ARQUITECTURA Y DOMINIOS DE CACHÉ" Style="{StaticResource KruzhMicroLabelStyle}" />
                                            <TextBlock x:Name="HwCpuArchText" Text="-" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource KruzhTextPrimaryBrush}" />
                                            <TextBlock x:Name="HwCcdL3Text" Text="-" FontSize="12" Foreground="{StaticResource KruzhTextSecondaryBrush}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource KruzhCardStyle}" Padding="20,16">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="RED Y CHASIS" Style="{StaticResource KruzhMicroLabelStyle}" />
                                            <TextBlock x:Name="HwNicNameText" Text="-" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource KruzhTextPrimaryBrush}" />
                                            <TextBlock x:Name="HwBatteryText" Text="-" FontSize="12" Foreground="{StaticResource KruzhTextSecondaryBrush}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource KruzhCardStyle}" Padding="20,16">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="FIRMWARE UEFI / BIOS" Style="{StaticResource KruzhMicroLabelStyle}" />
                                            <TextBlock x:Name="HwBiosText" Text="-" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource KruzhTextPrimaryBrush}" />
                                            <TextBlock x:Name="SidebarChassisBadge" Text="-" FontSize="12" Foreground="{StaticResource KruzhTextSecondaryBrush}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource KruzhCardStyle}" Padding="20,16">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="SEGURIDAD DEL SISTEMA" Style="{StaticResource KruzhMicroLabelStyle}" />
                                            <TextBlock x:Name="HwSecurityStateText" Text="-" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource KruzhTextPrimaryBrush}" />
                                            <TextBlock Text="KRUZH LATENCY · KRUZH — author" FontSize="12" Foreground="{StaticResource KruzhTextTertiaryBrush}" />
                                            <TextBlock x:Name="SidebarCpuSummary" Visibility="Collapsed" />
                                            <TextBlock x:Name="SidebarGpuSummary" Visibility="Collapsed" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>

                            <StackPanel Spacing="12">
                                <TextBlock Text="LICENCIA COMERCIAL Y HWID" Style="{StaticResource KruzhMicroLabelStyle}" />
                                <Border Style="{StaticResource KruzhCardStyle}">
                                    <StackPanel Spacing="14">
                                        <Grid ColumnSpacing="14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="HwidReadOnlyBox" Grid.Column="0" Header="Hardware ID (HWID)" IsReadOnly="True" FontFamily="Consolas" />
                                            <TextBox x:Name="LicenseKeyInputBox" Grid.Column="1" Header="Clave de licencia" PlaceholderText="KRUZH-XXXX-XXXX-XXXX" FontFamily="Consolas" />
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                                                <Button Click="ShowEulaModalBtn_Click" Style="{StaticResource KruzhGhostButtonStyle}" Content="Ver EULA" />
                                                <Button Click="ActivateLicenseBtn_Click" Style="{StaticResource KruzhPrimaryButtonStyle}" Content="Activar licencia" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock x:Name="LicenseDetailsStatusText" Text="-" FontSize="12" Foreground="{StaticResource KruzhTextSecondaryBrush}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>

                </Grid>
        </NavigationView>

        <!-- Instant Animated Styled Info Popup Overlay (0ms hover/click, #181A1D translucent, 150ms CubicEase) -->
        <Canvas x:Name="InstantTooltipOverlayCanvas"
                Grid.Row="0"
                Grid.RowSpan="2"
                IsHitTestVisible="False"
                Canvas.ZIndex="999">
            <Border x:Name="InstantTooltipCard"
                    Visibility="Collapsed"
                    Opacity="0"
                    Background="#1B1C1F"
                    BorderBrush="#2A2C30"
                    BorderThickness="1"
                    CornerRadius="9"
                    Padding="12"
                    MaxWidth="300"
                    Translation="0,0,32">
                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>
                <Border.RenderTransform>
                    <CompositeTransform x:Name="InstantTooltipTransform"
                                        TranslateY="6"
                                        ScaleX="0.96"
                                        ScaleY="0.96"
                                        CenterX="150"
                                        CenterY="40" />
                </Border.RenderTransform>
                <StackPanel Spacing="6">
                    <TextBlock x:Name="InstantTooltipTitleText"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource KruzhTextPrimaryBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="InstantTooltipDescText"
                               FontSize="11.5"
                               Foreground="{StaticResource KruzhTextSecondaryBrush}"
                               TextWrapping="Wrap" />
                    <Border Background="#08FFFFFF"
                            BorderBrush="#12FFFFFF"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="8,5"
                            Margin="0,2,0,0">
                        <TextBlock x:Name="InstantTooltipKeyText"
                                   FontFamily="Consolas"
                                   FontSize="10.5"
                                   Foreground="{StaticResource KruzhTextTertiaryBrush}"
                                   TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Border>
        </Canvas>

        <!-- ======================================================================= -->
        <!-- OVERLAY AL "APLICAR CAMBIOS" (MOCKUP KRUZH_LOADERS 1:1)                  -->
        <!-- ======================================================================= -->
        <!-- ======================================================================= -->
        <!-- MODAL DE LA APP (reemplaza a ContentDialog de Windows): confirmaciones y avisos -->
        <!-- ======================================================================= -->
        <Grid x:Name="AppModalOverlay" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed">
            <Border Tapped="AppModalScrim_Tapped">
                <Border.Background>
                    <AcrylicBrush TintColor="#070707" TintOpacity="0.55" TintLuminosityOpacity="0.55" FallbackColor="#8C070707" />
                </Border.Background>
            </Border>
            <Border x:Name="AppModalCard" Width="460" MaxHeight="560" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#000000" BorderBrush="#1F1F1F" BorderThickness="1" CornerRadius="12" Padding="28,24"
                    Translation="0,0,40">
                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="AppModalTitleText" Text="-" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource KruzhTextPrimaryBrush}" />
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <TextBlock x:Name="AppModalMessageText" Text="-" FontSize="13" TextWrapping="Wrap" LineHeight="20" Foreground="{StaticResource KruzhTextSecondaryBrush}" />
                    </ScrollViewer>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button x:Name="AppModalSecondaryBtn" Click="AppModalSecondaryBtn_Click" Style="{StaticResource KruzhGhostButtonStyle}" Content="Cancelar" MinWidth="110" />
                        <Button x:Name="AppModalPrimaryBtn" Click="AppModalPrimaryBtn_Click" Style="{StaticResource KruzhPrimaryButtonStyle}" Content="Aceptar" MinWidth="110" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Grid.RowSpan=2: cubre barra de título + contenido (antes quedaba atrapado en la fila de 38px del título). -->
        <Grid x:Name="ApplyingChangesOverlay" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <!-- Velo rgba(7,7,7,.55) + blur: el acrílico in-app desenfoca la UI de abajo sin taparla. -->
            <Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Border.Background>
                    <AcrylicBrush TintColor="#070707" TintOpacity="0.55" TintLuminosityOpacity="0.55" FallbackColor="#8C070707" />
                </Border.Background>
            </Border>

            <!-- Card Central Flotante -->
            <Border Width="500" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#000000" BorderBrush="#1F1F1F" BorderThickness="1"
                    CornerRadius="16" Padding="32,28" Translation="0,0,40">
                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>
                <StackPanel Spacing="16" HorizontalAlignment="Stretch">
                    <!-- Cabecera: Loader + Titulo + Punto de restauracion -->
                    <StackPanel HorizontalAlignment="Center" Spacing="8">
                        <Grid Width="180" Height="180" HorizontalAlignment="Center">
                            <Grid x:Name="OverlayFallbackSpinner" Width="46" Height="46" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse Stroke="#222222" StrokeThickness="3" Width="40" Height="40" />
                                <Canvas Width="40" Height="40">
                                    <Path Stroke="#63C088" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Data="M 20 0 A 20 20 0 0 1 40 20">
                                        <Path.RenderTransform>
                                            <RotateTransform x:Name="OverlaySpinnerRotate" CenterX="20" CenterY="20" />
                                        </Path.RenderTransform>
                                    </Path>
                                </Canvas>
                            </Grid>
                            <WebView2 x:Name="OverlayBoxLoaderWebView" Width="180" Height="180" Opacity="0"
                                      IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock x:Name="OverlayTitleText" Text="Aplicando cambios" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{StaticResource KruzhTextPrimaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock x:Name="OverlayRestorePointText" Text="Punto de restauración creado ✓"
                                   FontSize="12" Foreground="{StaticResource KruzhPositiveBrush}" HorizontalAlignment="Center" />
                    </StackPanel>

                    <!--
                      Carrusel de 3 líneas: banda iluminada FIJA en el medio (lo que se está aplicando) y una pista de 4 filas
                      que se desliza hacia arriba una posición cada vez que termina un tweak. Arriba = ya aplicado, abajo = en espera.
                      Paso de la pista = 44 (alto de fila) + 4 (separación) = 48.
                    -->
                    <Grid Height="140" Margin="0,6,0,0">
                        <Border CornerRadius="10" Background="#0C0C0C" BorderBrush="#1C1C1C" BorderThickness="1" />

                        <!-- Banda fija del tweak en foco -->
                        <Border Height="44" Margin="6,0" VerticalAlignment="Center" CornerRadius="8"
                                Background="#1D1D1D" BorderBrush="#2C2C2C" BorderThickness="1" />

                        <!-- Ventana recortada (3 filas visibles) con la pista que se desliza -->
                        <Grid x:Name="CarouselViewport" Margin="6,0">
                            <Grid.Clip>
                                <RectangleGeometry Rect="0,0,2000,140" />
                            </Grid.Clip>
                            <StackPanel x:Name="CarouselTrack" Spacing="4" VerticalAlignment="Top">
                                <StackPanel.RenderTransform>
                                    <TranslateTransform x:Name="CarouselTrackTransform" Y="0" />
                                </StackPanel.RenderTransform>

                                <!-- Fila 0 (arriba): ya aplicado -->
                                <Grid Height="44" Padding="14,0" Opacity="0.45">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon x:Name="CarouselPrevIcon" Glyph="&#xE73E;" FontSize="12" Foreground="{StaticResource KruzhPositiveBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" x:Name="CarouselPrevTitleText" Text="(Inicio del lote)"
                                               FontSize="12" Foreground="{StaticResource KruzhTextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" x:Name="CarouselPrevStatusText" Text=""
                                               FontSize="11" Foreground="{StaticResource KruzhPositiveBrush}" VerticalAlignment="Center" Margin="10,0,0,0" />
                                </Grid>

                                <!-- Fila 1 (medio, sobre la banda): aplicando -->
                                <Grid Height="44" Padding="14,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="7" Height="7" Fill="{StaticResource KruzhPositiveBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" x:Name="CarouselActiveTitleText" Text="Preparando cambios…"
                                               FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource KruzhTextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" x:Name="CarouselActiveStatusText" Text="aplicando…"
                                               FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource KruzhPositiveBrush}" VerticalAlignment="Center" Margin="10,0,0,0" />
                                </Grid>

                                <!-- Fila 2 (abajo): en espera -->
                                <Grid Height="44" Padding="14,0" Opacity="0.45">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE823;" FontSize="12" Foreground="{StaticResource KruzhTextTertiaryBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" x:Name="CarouselNextTitleText" Text=""
                                               FontSize="12" Foreground="{StaticResource KruzhTextTertiaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" x:Name="CarouselNextStatusText" Text="en espera"
                                               FontSize="11" Foreground="{StaticResource KruzhTextTertiaryBrush}" VerticalAlignment="Center" Margin="10,0,0,0" />
                                </Grid>

                                <!-- Fila 3 (fuera de vista): entra desde abajo al deslizar -->
                                <Grid Height="44" Padding="14,0" Opacity="0.45">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE823;" FontSize="12" Foreground="{StaticResource KruzhTextTertiaryBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" x:Name="CarouselNext2TitleText" Text=""
                                               FontSize="12" Foreground="{StaticResource KruzhTextTertiaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" x:Name="CarouselNext2StatusText" Text=""
                                               FontSize="11" Foreground="{StaticResource KruzhTextTertiaryBrush}" VerticalAlignment="Center" Margin="10,0,0,0" />
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <!-- Degradés superior e inferior (desvanecen las filas que entran/salen) -->
                        <Border Height="22" VerticalAlignment="Top" CornerRadius="10,10,0,0" IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                    <GradientStop Color="#EE0C0C0C" Offset="0.0" />
                                    <GradientStop Color="#000C0C0C" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border Height="22" VerticalAlignment="Bottom" CornerRadius="0,0,10,10" IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0.5,1" EndPoint="0.5,0">
                                    <GradientStop Color="#EE0C0C0C" Offset="0.0" />
                                    <GradientStop Color="#000C0C0C" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Grid>

                    <!-- Barra de progreso fina + Contador N / Total aplicados -->
                    <StackPanel Spacing="8" Margin="0,4,0,0">
                        <ProgressBar x:Name="OverlayProgressBar" Value="0" Maximum="100" Height="3"
                                     Foreground="{StaticResource KruzhPositiveBrush}" Background="#1E1E1E" CornerRadius="2" />
                        <Grid>
                            <TextBlock x:Name="OverlayStepDescText" Text="Optimizando parámetros del kernel..."
                                       FontSize="11.5" Foreground="{StaticResource KruzhTextTertiaryBrush}" HorizontalAlignment="Left" />
                            <TextBlock x:Name="OverlayCountText" Text="0 / 0 aplicados"
                                       FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource KruzhTextSecondaryBrush}" HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
