                                                        </Grid>
                                                    </Border>

                                                    <!-- Bottom Meta Bar -->
                                                    <Grid Grid.Row="1" Background="#131313" CornerRadius="0,0,11,11" Padding="11,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Ellipse Grid.Column="0" Width="6" Height="6"
                                                                 Fill="{Binding StatusDotBrush}"
                                                                 VerticalAlignment="Center" Margin="0,0,7,0" />
                                                        <TextBlock Grid.Column="1" Text="{Binding StatusText}"
                                                                   FontSize="11" Foreground="{StaticResource KruzhTextSecondaryBrush}"
                                                                   VerticalAlignment="Center" />
                                                        <Border Grid.Column="2" Visibility="{Binding OptimizedBadgeVisibility}"
                                                                Background="{StaticResource KruzhPositiveBgBrush}"
                                                                BorderBrush="{StaticResource KruzhPositiveBorderBrush}"
                                                                BorderThickness="1" CornerRadius="4" Padding="5,1" VerticalAlignment="Center">
                                                            <TextBlock Text="OPT" FontSize="9" FontWeight="Bold" Foreground="{StaticResource KruzhPositiveBrush}" />
                                                        </Border>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </GridView.ItemTemplate>
                                    <GridView.Footer>
                                        <!-- Card "+ Agregar juego" -->
                                        <Border Width="176" Height="276" Margin="0,0,12,12"
                                                CornerRadius="12"
                                                BorderBrush="#333333" BorderThickness="1"
                                                Background="Transparent"
                                                Tapped="AddCustomGameExeBtn_Click">
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                                                <FontIcon Glyph="&#xE710;" FontSize="24" Foreground="{StaticResource KruzhTextTertiaryBrush}" />
                                                <TextBlock Text="Agregar juego" FontSize="12" Foreground="{StaticResource KruzhTextTertiaryBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </GridView.Footer>
                                </GridView>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Modal de Optimización del Juego (Estilo Honest CS2 1:1) -->
                        <Grid x:Name="GameOptimizationModalOverlay" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <Border Background="#CC070707" Tapped="CloseGameModal_Tapped" />

                            <Border Width="640" MaxHeight="780" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Background="{StaticResource KruzhCardSurfaceBrush}"
                                    BorderBrush="{StaticResource KruzhHairlineBorderBrush}"
                                    BorderThickness="1" CornerRadius="14" Translation="0,0,32">
                                <Border.Shadow>
                                    <ThemeShadow />
                                </Border.Shadow>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Hero Header -->
                                    <Border Grid.Row="0" Height="110" CornerRadius="13,13,0,0">
                                        <Grid>
                                            <Border x:Name="ModalHeroBackground" Background="#2A1A2E" />
                                            <Border>
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#99191919" Offset="0.0" />
                                                        <GradientStop Color="#E6191919" Offset="1.0" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>

                                            <Grid Padding="22,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Width="54" Height="72" CornerRadius="7"
                                                        BorderBrush="#444444" BorderThickness="1"
                                                        VerticalAlignment="Center" Margin="0,0,16,0"
                                                        Background="#2A2410">
