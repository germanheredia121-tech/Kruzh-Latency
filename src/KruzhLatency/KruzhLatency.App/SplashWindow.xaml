<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="KruzhLatency.SplashWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Splash 420x300, fondo negro (igual al del box-loader: sin recuadro visible), borde fino + sombra nativa de Windows. Arriba el box-loader, abajo marca + estado. -->
    <Border Background="#000000" CornerRadius="8">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">

            <!-- Box-loader (WebView2 180x180 = contenedor .relative del HTML; más chico se corta). Spinner XAML solo si WebView2 no está disponible. -->
            <Grid Width="180" Height="180" HorizontalAlignment="Center">
                <Grid x:Name="SplashFallbackSpinner" Width="46" Height="46" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse Stroke="#1C1C1C" StrokeThickness="3" Width="40" Height="40" />
                    <Canvas Width="40" Height="40">
                        <Path Stroke="#63C088" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M 20 0 A 20 20 0 0 1 40 20">
                            <Path.RenderTransform>
                                <RotateTransform x:Name="SplashSpinnerRotate" CenterX="20" CenterY="20" />
                            </Path.RenderTransform>
                        </Path>
                    </Canvas>
                </Grid>
                <WebView2 x:Name="SplashBoxLoaderWebView" Width="180" Height="180" Opacity="0"
                          IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>

            <StackPanel HorizontalAlignment="Center" Spacing="4">
                <TextBlock Text="KRUZH LATENCY" FontSize="16" FontWeight="Bold" Foreground="#F2F2F2" CharacterSpacing="60" HorizontalAlignment="Center" />
                <TextBlock x:Name="SplashStatusText" Text="Iniciando…" FontSize="12.5" Foreground="#9A9A9A" HorizontalAlignment="Center" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
