<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>KruzhLatency</RootNamespace>
    <AssemblyName>KruzhLatency</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableCoreMrtTooling>false</EnableCoreMrtTooling>
    <AppxGeneratePriEnabled>false</AppxGeneratePriEnabled>
    <SelfContained>true</SelfContained>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>3.0.0</Version>
    <Company>KRUZH</Company>
    <Authors>KRUZH — author</Authors>
    <Product>KRUZH LATENCY</Product>
    <Copyright>Copyright © 2026 KRUZH — author. All rights reserved.</Copyright>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Optimize>true</Optimize>
    <StripSymbols>true</StripSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.5.240802000" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.22621.3233" GeneratePathProperty="true" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KruzhLatency.Core\KruzhLatency.Core.csproj" />
    <ProjectReference Include="..\KruzhLatency.Infra\KruzhLatency.Infra.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    resources.pri (fix crash "Cannot locate resource ms-appx:///Microsoft.UI.Xaml/Themes/themeresources.xaml").
    WinUI sin empaquetar necesita un resources.pri junto al exe con los .xbf de la app + Microsoft.UI.Xaml.Controls.pri.
    La generación estándar (EnableCoreMrtTooling) usa una tarea que solo trae Visual Studio y falla con `dotnet build`
    (MSB4062), por eso está apagada arriba y acá se genera con makepri.exe del paquete Microsoft.Windows.SDK.BuildTools.
    Corre en cada build (Debug, Release, CI) y se copia también al publicar.
  -->
  <Target Name="KruzhGenerateResourcesPri" AfterTargets="Build" Condition="'$(OS)' == 'Windows_NT'">
    <!-- Propiedades DENTRO del target: IntermediateOutputPath recién está definido en tiempo de ejecución
         (a nivel de proyecto vale vacío y la carpeta temporal terminaba en la raíz del proyecto). -->
    <PropertyGroup>
      <KruzhMakePriExe>$(PkgMicrosoft_Windows_SDK_BuildTools)\bin\10.0.22621.0\x64\makepri.exe</KruzhMakePriExe>
      <KruzhPriStageDir>$(ProjectDir)$(IntermediateOutputPath)pri-stage\</KruzhPriStageDir>
      <KruzhPriConfig>$(ProjectDir)$(IntermediateOutputPath)priconfig.xml</KruzhPriConfig>
    </PropertyGroup>
    <Error Condition="'$(IntermediateOutputPath)' == ''" Text="IntermediateOutputPath vacío: no se puede ubicar la carpeta temporal de PRI." />
    <Error Condition="!Exists('$(KruzhMakePriExe)')" Text="No se encontró makepri.exe en '$(KruzhMakePriExe)'. Restaurá los paquetes NuGet (Microsoft.Windows.SDK.BuildTools)." />
    <ItemGroup>
      <_KruzhPriInputs Include="$(OutDir)*.xbf" />
      <_KruzhPriInputs Include="$(OutDir)Microsoft.UI.Xaml.Controls.pri" />
    </ItemGroup>
    <Error Condition="'@(_KruzhPriInputs)' == ''" Text="No hay .xbf en $(OutDir) para indexar en resources.pri." />
    <RemoveDir Directories="$(KruzhPriStageDir)" />
    <Copy SourceFiles="@(_KruzhPriInputs)" DestinationFolder="$(KruzhPriStageDir)" />
    <Exec Command="&quot;$(KruzhMakePriExe)&quot; createconfig /cf &quot;$(KruzhPriConfig)&quot; /dq en-US /pv 10.0.0 /o" StandardOutputImportance="low" />
    <Exec Command="&quot;$(KruzhMakePriExe)&quot; new /pr &quot;$(KruzhPriStageDir.TrimEnd('\'))&quot; /cf &quot;$(KruzhPriConfig)&quot; /in $(AssemblyName) /of &quot;$(OutDir)resources.pri&quot; /o" StandardOutputImportance="low" />
    <Error Condition="!Exists('$(OutDir)resources.pri')" Text="makepri no generó $(OutDir)resources.pri." />
  </Target>

  <Target Name="KruzhCopyResourcesPriOnPublish" AfterTargets="Publish" Condition="Exists('$(OutDir)resources.pri')">
    <Copy SourceFiles="$(OutDir)resources.pri" DestinationFolder="$(PublishDir)" />
  </Target>
</Project>
