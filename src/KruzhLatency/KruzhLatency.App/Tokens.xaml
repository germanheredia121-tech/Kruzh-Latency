<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========================================================================= -->
    <!-- KRUZH LATENCY — NEAR-BLACK FLUENT DESIGN TOKENS (KRUZH — author)          -->
    <!-- ========================================================================= -->

    <!-- Exact Reference Palette Tokens (Honest Program Pure Neutral Grayscale) -->
    <!-- Fondo ventana: #0F0F0F (sólido, neutro, sin cast azul) -->
    <Color x:Key="KruzhBgColor">#0F0F0F</Color>

    <!-- Card fill sólido: #191919 -->
    <Color x:Key="KruzhCardFillColor">#191919</Color>

    <!-- Card borde sólido sutil: #242424 -->
    <Color x:Key="KruzhCardBorderColor">#242424</Color>

    <!-- Fila hover / pendiente: #202020 -->
    <Color x:Key="KruzhRowHoverPendingColor">#202020</Color>

    <!-- Divisor entre filas: #242424 -->
    <Color x:Key="KruzhDividerColor">#242424</Color>

    <!-- Primary / Secondary / Micro-label Text (Neutro Inter / Segoe UI) -->
    <Color x:Key="KruzhTextPrimaryColor">#F2F2F2</Color>
    <Color x:Key="KruzhTextSecondaryColor">#9A9A9A</Color>
    <Color x:Key="KruzhTextTertiaryColor">#5E5E5E</Color>

    <Color x:Key="KruzhCardHoverColor">#202020</Color>
    <Color x:Key="KruzhCardOpaqueColor">#191919</Color>
    <Color x:Key="KruzhHairlineBorderColor">#242424</Color>
    <Color x:Key="KruzhActiveStrokeColor">#303030</Color>
    <Color x:Key="KruzhSparklineColor">#33FFFFFF</Color>

    <!-- Neutral Control Accent (Blanco / Gris neutro) -->
    <Color x:Key="KruzhAccentNeutralColor">#F2F2F2</Color>

    <!-- Single Positive Accent (#63C088): ONLY for real calculated status pill and license dot -->
    <Color x:Key="KruzhPositiveColor">#63C088</Color>
    <Color x:Key="KruzhPositiveBgColor">#1A63C088</Color>
    <Color x:Key="KruzhPositiveBorderColor">#3863C088</Color>

    <!-- Amber semántico (#B8975F): para advertencias de impacto medio en BIOS/NVRAM -->
    <Color x:Key="KruzhAmberColor">#B8975F</Color>
    <Color x:Key="KruzhAmberBgColor">#1AB8975F</Color>
    <Color x:Key="KruzhAmberBorderColor">#40B8975F</Color>

    <!-- Desaturated Red (#B85F5F): ONLY for Anticheat/Security warning or real DPC Alert -->
    <Color x:Key="KruzhDangerMutedColor">#B85F5F</Color>
    <Color x:Key="KruzhDangerMutedBgColor">#1AB85F5F</Color>
    <Color x:Key="KruzhDangerMutedBorderColor">#40B85F5F</Color>

    <!-- Core Brushes (100% Solid & Opaque, Pure Neutral Dark Background) -->
    <LinearGradientBrush x:Key="KruzhBgBrush" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#121212" Offset="0.0" />
        <GradientStop Color="#0F0F0F" Offset="1.0" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="KruzhTextPrimaryBrush" Color="{StaticResource KruzhTextPrimaryColor}" />
    <SolidColorBrush x:Key="KruzhTextSecondaryBrush" Color="{StaticResource KruzhTextSecondaryColor}" />
    <SolidColorBrush x:Key="KruzhTextTertiaryBrush" Color="{StaticResource KruzhTextTertiaryColor}" />

    <!-- Solid Card Fill: #191919 -->
    <SolidColorBrush x:Key="KruzhCardSurfaceBrush" Color="{StaticResource KruzhCardFillColor}" />

    <SolidColorBrush x:Key="KruzhCardHoverBrush" Color="{StaticResource KruzhCardHoverColor}" />
    <SolidColorBrush x:Key="KruzhCardOpaqueBrush" Color="{StaticResource KruzhCardOpaqueColor}" />
    <SolidColorBrush x:Key="KruzhHairlineBorderBrush" Color="{StaticResource KruzhHairlineBorderColor}" />
    <SolidColorBrush x:Key="KruzhDividerHairlineBrush" Color="{StaticResource KruzhDividerColor}" />
    <SolidColorBrush x:Key="KruzhRowHoverPendingBrush" Color="{StaticResource KruzhRowHoverPendingColor}" />
    <SolidColorBrush x:Key="KruzhActiveStrokeBrush" Color="{StaticResource KruzhActiveStrokeColor}" />
    <SolidColorBrush x:Key="KruzhSparklineBrush" Color="{StaticResource KruzhSparklineColor}" />
    <SolidColorBrush x:Key="KruzhAccentNeutralBrush" Color="{StaticResource KruzhAccentNeutralColor}" />

    <SolidColorBrush x:Key="KruzhPositiveBrush" Color="{StaticResource KruzhPositiveColor}" />
    <SolidColorBrush x:Key="KruzhPositiveBgBrush" Color="{StaticResource KruzhPositiveBgColor}" />
    <SolidColorBrush x:Key="KruzhPositiveBorderBrush" Color="{StaticResource KruzhPositiveBorderColor}" />

    <SolidColorBrush x:Key="KruzhAmberBrush" Color="{StaticResource KruzhAmberColor}" />
    <SolidColorBrush x:Key="KruzhAmberBgBrush" Color="{StaticResource KruzhAmberBgColor}" />
    <SolidColorBrush x:Key="KruzhAmberBorderBrush" Color="{StaticResource KruzhAmberBorderColor}" />

    <SolidColorBrush x:Key="KruzhDangerMutedBrush" Color="{StaticResource KruzhDangerMutedColor}" />
    <SolidColorBrush x:Key="KruzhDangerMutedBgBrush" Color="{StaticResource KruzhDangerMutedBgColor}" />
    <SolidColorBrush x:Key="KruzhDangerMutedBorderBrush" Color="{StaticResource KruzhDangerMutedBorderColor}" />

    <!-- ========================================================================= -->
    <!-- WINUI 3 THEME RESOURCE OVERRIDES (NEUTRALIZES DEFAULT BLUE ACCENTS)       -->
    <!-- ========================================================================= -->
    <Color x:Key="SystemAccentColor">#F2F2F2</Color>
    <Color x:Key="SystemAccentColorLight1">#F2F2F2</Color>
    <Color x:Key="SystemAccentColorLight2">#F2F2F2</Color>
    <Color x:Key="SystemAccentColorLight3">#F2F2F2</Color>
    <Color x:Key="SystemAccentColorDark1">#CCCCCC</Color>
    <Color x:Key="SystemAccentColorDark2">#AAAAAA</Color>
    <Color x:Key="SystemAccentColorDark3">#9A9A9A</Color>

    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#F2F2F2" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#DDDDDD" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#BBBBBB" />
    <SolidColorBrush x:Key="AccentFillColorSelectedTextBackgroundBrush" Color="#26FFFFFF" />

    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#161616" />
    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#161616" />
    <SolidColorBrush x:Key="TextOnAccentFillColorSelectedTextBrush" Color="#F2F2F2" />

    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#F2F2F2" />
    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#F2F2F2" />
    <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#9A9A9A" />

    <!-- ========================================================================= -->
    <!-- SOLID OPAQUE SURFACE & NATIVE NAVIGATIONVIEW OVERRIDES                   -->
    <!-- ========================================================================= -->
    <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#0F0F0F" />
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#0F0F0F" />
    <SolidColorBrush x:Key="LayerFillColorAltBrush" Color="#0F0F0F" />
    <SolidColorBrush x:Key="LayerOnMicaBaseAltFillColorDefaultBrush" Color="#0F0F0F" />
    <SolidColorBrush x:Key="LayerOnMicaBaseAltFillColorSecondaryBrush" Color="#0F0F0F" />
    <SolidColorBrush x:Key="LayerOnMicaBaseAltFillColorTransparentBrush" Color="#0F0F0F" />

    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#0F0F0F" />
    <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
    <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
    <CornerRadius x:Key="NavigationViewContentGridCornerRadius">0</CornerRadius>
    <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#0F0F0F" />
    <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="#0F0F0F" />
    <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#0F0F0F" />
    <SolidColorBrush x:Key="NavigationViewPaneBorderBrush" Color="#242424" />
    <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#F2F2F2" />
    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#202020" />
    <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#191919" />
    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#242424" />
    <SolidColorBrush x:Key="NavigationViewItemForeground" Color="#9A9A9A" />
    <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#F2F2F2" />
    <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="#F2F2F2" />
    <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="#F2F2F2" />

    <!-- Card & Control Surface Overrides (Neutral #191919, Border #242424) -->
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#191919" />
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#191919" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#242424" />
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#202020" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#242424" />
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#242424" />
    <SolidColorBrush x:Key="ControlElevationBorderBrush" Color="#242424" />
    <SolidColorBrush x:Key="FocusStrokeColorOuterBrush" Color="#5E5E5E" />
    <SolidColorBrush x:Key="ContentDialogBackground" Color="#191919" />
    <SolidColorBrush x:Key="ContentDialogTopOverlay" Color="#202020" />
    <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="#242424" />
    <x:Double x:Key="ToggleSwitchThemeMinWidth">0</x:Double>

    <!-- Professional Solid ToolTip Overrides (#1B1B1B, border #242424) -->
    <SolidColorBrush x:Key="ToolTipBackground" Color="#1B1B1B" />
    <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#242424" />
    <SolidColorBrush x:Key="ToolTipForeground" Color="#F2F2F2" />
    <Thickness x:Key="ToolTipBorderThemeThickness">1</Thickness>
    <x:Double x:Key="ToolTipMaxWidth">300</x:Double>

    <!-- Thin Overlay ScrollBar Overrides -->
    <SolidColorBrush x:Key="ScrollBarBackground" Color="Transparent" />
    <SolidColorBrush x:Key="ScrollBarBackgroundPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="ScrollBarTrackFill" Color="Transparent" />
    <SolidColorBrush x:Key="ScrollBarTrackFillPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="ScrollBarTrackStroke" Color="Transparent" />
    <SolidColorBrush x:Key="ScrollBarTrackStrokePointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="ScrollBarThumbFill" Color="#22FFFFFF" />
    <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="#38FFFFFF" />
    <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="#55FFFFFF" />
    <SolidColorBrush x:Key="ScrollBarPanningThumbBackground" Color="#22FFFFFF" />

    <!-- ========================================================================= -->
    <!-- TYPOGRAPHY & UNIFORM CARD / BUTTON STYLES                                 -->
    <!-- ========================================================================= -->
    <Style x:Key="KruzhMicroLabelStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource KruzhTextTertiaryBrush}" />
        <Setter Property="CharacterSpacing" Value="120" />
    </Style>

    <Style x:Key="KruzhPageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource KruzhTextPrimaryBrush}" />
    </Style>

    <Style x:Key="KruzhPageSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource KruzhTextSecondaryBrush}" />
    </Style>

    <Style x:Key="KruzhMetricLightStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="Light" />
        <Setter Property="Foreground" Value="{StaticResource KruzhTextPrimaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,-2" />
    </Style>

    <!-- Single Uniform Card Style: solid #191919 fill + border #242424 -->
    <Style x:Key="KruzhCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource KruzhCardSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource KruzhHairlineBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="20,16" />
    </Style>

    <Style x:Key="KruzhSubCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource KruzhCardSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource KruzhHairlineBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="16,13" />
    </Style>

    <!-- Single Container per Category Style (Windows 11 Settings / Honest AI Grouped Card) -->
    <Style x:Key="KruzhCategoryGroupCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource KruzhCardSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource KruzhHairlineBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="KruzhSettingsCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource KruzhCardSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource KruzhHairlineBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="20,16" />
    </Style>

    <Style x:Key="KruzhGhostButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#1F1F1F" />
        <Setter Property="BorderBrush" Value="{StaticResource KruzhHairlineBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource KruzhTextPrimaryBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <Style x:Key="KruzhPrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource KruzhAccentNeutralBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource KruzhAccentNeutralBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="#161616" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="KruzhBadgeOutlineStyle" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource KruzhHairlineBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="7,2" />
    </Style>

    <Style x:Key="KruzhBadgeActiveStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource KruzhCardHoverBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource KruzhActiveStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="7,2" />
    </Style>

    <!-- Positive Status Pill ("Estable" / "Aplicado"): uses #63C088 -->
    <Style x:Key="KruzhPositivePillStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource KruzhPositiveBgBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource KruzhPositiveBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="8,2" />
    </Style>

    <!-- Pending Status Pill ("Pendiente"): solid #202020 + border #303030 -->
    <Style x:Key="KruzhPendingPillStyle" TargetType="Border">
        <Setter Property="Background" Value="#202020" />
        <Setter Property="BorderBrush" Value="#303030" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="8,2" />
    </Style>

    <!-- Library Tab Button Style (Honest Program Tabs) -->
    <Style x:Key="KruzhTabButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0,0,0,2" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource KruzhTextSecondaryBrush}" />
        <Setter Property="Padding" Value="2,0,2,10" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <!-- Professional Solid ToolTip Style (#1B1B1B, border #242424, CornerRadius 9, MaxWidth 300) -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="#1B1B1B" />
        <Setter Property="Foreground" Value="{StaticResource KruzhTextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="#242424" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="MaxWidth" Value="300" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <!-- Tarjeta seleccionable (perfiles de GPU): borde fino, sin relleno; el estado seleccionado lo pinta el código -->
    <Style x:Key="KruzhSelectableCardStyle" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="#2A2A2A" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="18,16" />
        <Setter Property="MinHeight" Value="78" />
    </Style>

</ResourceDictionary>
