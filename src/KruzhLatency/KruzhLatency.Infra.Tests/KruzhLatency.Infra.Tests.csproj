<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests de integracion contra el Windows real. Todos van con [IntegrationFact]: se saltean salvo KRUZH_INTEGRATION=1
       y llevan Category=Integration (CI los filtra). -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\KruzhLatency.Infra\KruzhLatency.Infra.csproj" />
  </ItemGroup>
</Project>
